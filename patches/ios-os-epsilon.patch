+namespace {
+struct Track {
+  const char* title;
+  const char* artist;
+  uint32_t length;
+};
+constexpr Track k_tracks[] = {
+    {"Integrale de nuit", "Les Derivees", 192000},
+    {"Sinus d'ete", "Pi & les Radians", 167000},
+    {"Asymptote", "Limite Zero", 215000},
+    {"Base 10", "Les Logarithmes", 178000},
+};
+constexpr int k_numberOfTracks = sizeof(k_tracks) / sizeof(k_tracks[0]);
+}  // namespace
+
+const char* trackTitle(int t) { return k_tracks[t % k_numberOfTracks].title; }
+const char* trackArtist(int t) { return k_tracks[t % k_numberOfTracks].artist; }
+uint32_t trackLength(int t) { return k_tracks[t % k_numberOfTracks].length; }
+
+void updateMusic() {
+  uint32_t t = now();
+  if (s.music.playing) {
+    s.music.position += t - s.music.lastUpdate;
+    while (s.music.position >= trackLength(s.music.track)) {
+      s.music.position -= trackLength(s.music.track);
+      s.music.track = (s.music.track + 1) % k_numberOfTracks;
+    }
+  }
+  s.music.lastUpdate = t;
+}
+
+void musicToggle() {
+  updateMusic();
+  s.music.playing = !s.music.playing;
+}
+
+void musicSkip(int direction) {
+  updateMusic();
+  s.music.track = (s.music.track + k_numberOfTracks + direction) % k_numberOfTracks;
+  s.music.position = 0;
+}
