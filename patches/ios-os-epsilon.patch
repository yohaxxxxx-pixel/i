+// Intro: icons fly in from slightly bigger and transparent, from the centre
+void introFor(int sx, int sy, float* scale, int* alpha) {
+  *scale = 1.f;
+  *alpha = 256;
+  if (!introRunning()) {
+    return;
+  }
+  int dx = sx - 160, dy = sy - 110;
+  int delay = static_cast<int>(sqrtf(static_cast<float>(dx * dx + dy * dy)) * 1.1f);
+  float t = clamp01(static_cast<float>(static_cast<int>(now() - s.introStart) - delay) /
+                    300.f);
+  float e = easeBack(t);
+  *scale = 1.35f - 0.35f * e;
+  *alpha = static_cast<int>(clamp01(t * 1.6f) * 256);
+}
+
+void drawPage(Band& b, int page, int ox) {
+  if (ox <= -k_screenWidth || ox >= k_screenWidth) {
+    return;
+  }
+  bool selectedPage = s.focus == Focus::Grid && page == s.page;
+  float pop = 1.f + 0.13f * easeBack(elapsed(s.selectStart, 240));
+  if (page == 0) {
+    int content = cellContent(s.page, s.column, s.row);
+    for (int w = 0; w < 2; w++) {
+      Rect r = (w == 0 ? k_widgetWeather : k_widgetCalendar).translated(ox, 0);
+      if (!r.inset(-4).intersects(b.clip()) && !Rect{r.x, r.bottom(), r.w, 18}.intersects(b.clip())) {
+        continue;
+      }
+      float scale;
+      int alpha;
+      introFor(r.x + r.w / 2, r.y + r.h / 2, &scale, &alpha);
+      if (scale != 1.f) {
+        int dw = static_cast<int>(r.w * (scale - 1.f) / 2), dh = static_cast<int>(r.h * (scale - 1.f) / 2);
+        r = {r.x - dw, r.y - dh, r.w + 2 * dw, r.h + 2 * dh};
+      }
+      bool sel = selectedPage && content == (w == 0 ? k_cellWeather : k_cellCalendar);
+      if (alpha < 200) {
+        // Flying in: only the glass, the text comes when it is in place
+        drawWidgetFrame(b, r, false, alpha);
+        continue;
+      }
+      if (w == 0) {
+        drawWeatherWidget(b, r, sel, alpha);
+      } else {
+        drawCalendarWidget(b, r, sel, alpha);
+      }
+      shadowText(b, w == 0 ? "Meteo" : "Calendrier", r.x + r.w / 2,
+                 (w == 0 ? k_widgetWeather : k_widgetCalendar).bottom() + 4,
+                 rgb(0xFFFFFF), 120, alpha);
+    }
+  }
+  for (int row = 0; row < k_rows; row++) {
+    for (int col = 0; col < k_columns; col++) {
+      int content = cellContent(page, col, row);
+      if (content < 0) {
+        continue;
+      }
+      int x, y;
+      cellIconPos(0, col, row, &x, &y);
+      x += ox;
+      if (!Rect{x - 14, y - 6, k_icon + 28, k_icon + 26}.intersects(b.clip())) {
+        continue;
+      }
+      float scale;
+      int alpha;
+      introFor(x + k_icon / 2, y + k_icon / 2, &scale, &alpha);
+      bool sel = selectedPage && col == s.column && row == s.row;
+      if (sel) {
+        scale *= pop;
+      }
+      drawIconAt(b, s.slots[content], x, y, scale, alpha, true, sel);
+    }
+  }
+}
+
+void drawDots(Band& b) {
+  int n = numberOfPages();
+  if (n <= 1) {
+    return;
+  }
+  int w = n * 11 + 10;
+  Rect pill = {160 - w / 2, k_dotsY - 6, w, 12};
+  if (!pill.intersects(b.clip())) {
+    return;
+  }
+  Glass g = s.dark ? k_darkGlass : k_clearGlass;
+  g.refraction = 3;
+  glass(b, pill, 6, blurredWallpaper, g);
+  for (int i = 0; i < n; i++) {
+    float d = fabsf(s.scroll - i);
+    int a = 110 + static_cast<int>(146 * clamp01(1.f - d));
+    disc(b, pill.x + 8 + i * 11, k_dotsY, 3, rgb(0xFFFFFF), a);
+  }
+}
+
+void drawDock(Band& b) {
+  if (!k_dockRect.inset(-4).intersects(b.clip())) {
+    return;
+  }
+  Glass g = s.dark ? k_darkGlass : k_clearGlass;
+  glass(b, k_dockRect, 22, blurredWallpaper, g);
+  float pop = 1.f + 0.13f * easeBack(elapsed(s.selectStart, 240));
+  for (int i = 0; i < k_dockSize; i++) {
+    if (s.dock[i].isEmpty()) {
+      continue;
+    }
+    float scale;
+    int alpha;
+    introFor(dockX(i) + k_icon / 2, k_dockIconY + k_icon / 2, &scale, &alpha);
+    bool sel = s.focus == Focus::Dock && s.dockIndex == i;
+    if (sel) {
+      scale *= pop;
+    }
+    drawIconAt(b, s.dock[i], dockX(i), k_dockIconY, scale, alpha, false, sel);
+  }
+}
+
+void drawSpringboard(Band& b) {
+  wallpaper(b);
+  int off = scrollOffset();
+  int first = off >= 0 ? off / k_screenWidth : -1;
+  for (int p = first; p <= first + 1; p++) {
+    if (p >= 0 && p < numberOfPages()) {
+      drawPage(b, p, p * k_screenWidth - off);
+    }
+  }
+  drawDots(b);
+  drawDock(b);
+}
+
+/* ============================================================ lock screen */
+
+void drawLockLayer(Band& b, int oy) {
+  wallpaper(b, 0, -oy);
+  KDColor white = rgb(0xFFFFFF);
+  Date d = today();
+  char date[32];
+  fmt(date, sizeof(date), "%s %d %s", weekdayName(d.weekday), d.day,
+      monthName(d.month));
+  tinted(b, IOSIcons::IconLockSmall, 156, 22 + oy, white, 220);
+  text(b, date, 160, 36 + oy, white, Small, Align::Center);
+  char clock[8];
+  clockText(clock, sizeof(clock), clockMinutes());
+  digits(b, clock, 160, 54 + oy, 52, white, Align::Center);
+  // A notification
+  Rect card = {40, 120 + oy, 240, 46};
+  if (card.inset(-3).intersects(b.clip())) {
+    Glass g = s.dark ? k_darkGlass : k_clearGlass;
+    glass(b, card, 16, blurredWallpaper, g);
+    image(b, IOSIcons::IconSettings, card.x + 8, card.y + 9, 28);
+    text(b, "iOS-OS", card.x + 44, card.y + 6, white, Small);
+    text(b, "maintenant", card.right() - 10, card.y + 6, rgb(0xEBEBF5), Small,
+         Align::Right);
+    text(b, "Var : centre de controle", card.x + 44, card.y + 24,
+         rgb(0xF2F2F7), Small, Align::Left, 188);
+  }
+  // Flashlight and clock buttons
+  for (int i = 0; i < 2; i++) {
+    Rect r = {i == 0 ? 30 : 254, 186 + oy, 36, 36};
+    if (!r.inset(-2).intersects(b.clip())) {
+      continue;
+    }
+    bool on = i == 0 && s.flashlight;
+    if (on) {
+      disc(b, r.x + 18, r.y + 18, 18, white);
+    } else {
+      Glass g = k_darkGlass;
+      g.tintAlpha = 110;
+      glass(b, r, 18, blurredWallpaper, g);
+    }
+    tinted(b, i == 0 ? IOSIcons::IconFlashlight : IOSIcons::IconTimer, r.x + 9,
+           r.y + 9, on ? rgb(0x1C1C1E) : white);
+  }
+  // "Press OK" with a light sweeping over it
+  const char* hint = "Appuie sur OK pour ouvrir";
+  int hw = textWidth(hint);
+  Rect hr = {160 - hw / 2, 204 + oy, hw, 14};
+  if (hr.intersects(b.clip())) {
+    text(b, hint, 160, 204 + oy, white, Small, Align::Center);
+    int sweep = static_cast<int>((now() / 8) % (hw + 160)) - 80;
+    Rect lit = {hr.x + sweep - 20, hr.y, 40, 14};
+    Rect old = b.clip();
+    if (b.setClip(lit.intersection(old))) {
+      text(b, hint, 160, 204 + oy, rgb(0x5AC8FA), Small, Align::Center);
+    }
+    b.setClip(old);
+  }
+  roundFill(b, {110, 229 + oy, 100, 4}, 2, white, 220);
+}
+
+void drawLock(Band& b) {
+  if (!unlocking()) {
+    drawLockLayer(b, 0);
+    return;
+  }
+  float t = easeOut(elapsed(s.unlockStart, k_unlockMs));
+  int oy = -static_cast<int>(t * k_screenHeight);
+  Rect old = b.clip();
+  Rect below = {0, k_screenHeight + oy, k_screenWidth, -oy};
+  if (b.setClip(below.intersection(old))) {
+    drawSpringboard(b);
+  }
+  b.setClip(old);
+  Rect above = {0, 0, k_screenWidth, k_screenHeight + oy};
+  if (b.setClip(above.intersection(old))) {
+    drawLockLayer(b, oy);
+  }
+  b.setClip(old);
+}
+
+/* ============================================================ the apps */
+
+void drawAppletScreen(Band& b) {
+  if (!appletZooming()) {
+    Apps::render(s.applet, b);
+    return;
+  }
+  float t = easeOut(elapsed(s.appletStart, k_appletZoomMs));
+  float p = s.appletClosing ? 1.f - t : t;
+  drawSpringboard(b);
+  dim(b, static_cast<int>(p * 70));
+  Rect r = lerpRect(s.appletFrom, k_screen, p);
+  int radius = static_cast<int>(18 * (1.f - p)) + 2;
+  // Like a launch screen: the app's background and its icon, then the app
+  if (p < 0.8f) {
+    roundFill(b, r, radius, theme().background);
+    int size = r.w < r.h ? r.w : r.h;
+    size = size * 2 / 3 < k_icon ? (size < k_icon ? size : k_icon) : size * 2 / 3;
+    if (size > 72) {
+      size = 72;
+    }
+    int alpha = static_cast<int>(clamp01((0.8f - p) * 4.f) * 256);
+    drawSlotIcon(b, appletSlot(s.applet), r.x + (r.w - size) / 2,
+                 r.y + (r.h - size) / 2, size, alpha);
+  } else {
+    Rect old = b.clip();
+    if (b.setClip(r.intersection(old))) {
+      Apps::render(s.applet, b);
+    }
+    b.setClip(old);
+  }
+}
+
+void drawLaunch(Band& b) {
+  fill(b, k_screen, theme().background);
+  drawSlotIcon(b, s_loadingSlot, 160 - 36, 84, 72);
+  text(b, slotLabel(s_loadingSlot), 160, 164, theme().text, Large, Align::Center);
+}
+
+/* ========================================================= control center */
+
+struct CCTile {
+  Rect r;
+  uint8_t kind;  // 0 circle toggle, 1 wide, 2 slider, 3 music, 4 inner circle
+};
+
+enum CC : int8_t {
+  CCAirplane = 0,
+  CCCellular,
+  CCWifi,
+  CCBluetooth,
+  CCMusic,
+  CCBrightness,
+  CCVolume,
+  CCFocus,
+  CCRotation,
+  CCDark,
+  CCFlashlight,
+  CCTimer,
+  CCCalculator,
+  CCNightShift,
+  CCLowPower,
+  CCStopwatch,
+  CCLock,
+  CCCount
+};
+
+constexpr int ccx(int col) { return 12 + col * 52; }
+constexpr int k_ccTop = 26;
+constexpr Rect k_ccConnect = {ccx(0), k_ccTop, 98, 98};
+
+constexpr CCTile k_cc[CCCount] = {
+    {{ccx(0) + 7, k_ccTop + 7, 38, 38}, 4},
+    {{ccx(0) + 53, k_ccTop + 7, 38, 38}, 4},
+    {{ccx(0) + 7, k_ccTop + 53, 38, 38}, 4},
+    {{ccx(0) + 53, k_ccTop + 53, 38, 38}, 4},
+    {{ccx(2), k_ccTop, 98, 98}, 3},
+    {{ccx(4), k_ccTop, 46, 98}, 2},
+    {{ccx(5), k_ccTop, 46, 98}, 2},
+    {{ccx(0), k_ccTop + 104, 150, 46}, 1},
+    {{ccx(3), k_ccTop + 104, 46, 46}, 0},
+    {{ccx(4), k_ccTop + 104, 46, 46}, 0},
+    {{ccx(5), k_ccTop + 104, 46, 46}, 0},
+    {{ccx(0), k_ccTop + 156, 46, 46}, 0},
+    {{ccx(1), k_ccTop + 156, 46, 46}, 0},
+    {{ccx(2), k_ccTop + 156, 46, 46}, 0},
+    {{ccx(3), k_ccTop + 156, 46, 46}, 0},
+    {{ccx(4), k_ccTop + 156, 46, 46}, 0},
+    {{ccx(5), k_ccTop + 156, 46, 46}, 0},
+};
+
+bool ccActive(int i) {
+  switch (i) {
+    case CCAirplane:
+      return s.airplane;
+    case CCCellular:
+      return s.cellular;
+    case CCWifi:
+      return s.wifi;
+    case CCBluetooth:
+      return s.bluetooth;
+    case CCFocus:
+      return s.focusMode;
+    case CCRotation:
+      return s.rotationLock;
+    case CCDark:
+      return s.dark;
+    case CCFlashlight:
+      return s.flashlight;
+    case CCNightShift:
+      return s.nightShift;
+    case CCLowPower:
+      return s.lowPower;
+    case CCTimer:
+      return s.timer.running;
+    case CCStopwatch:
+      return s.chrono.running;
+    default:
+      return false;
+  }
+}
+
+uint8_t ccIcon(int i) {
+  constexpr uint8_t k_icons[CCCount] = {
+      IOSIcons::IconAirplane,   IOSIcons::IconAntenna,  IOSIcons::IconWifi,
+      IOSIcons::IconBluetooth,  IOSIcons::IconPlay,     IOSIcons::IconSun,
+      IOSIcons::IconSpeaker,    IOSIcons::IconMoon,     IOSIcons::IconRotation,
+      IOSIcons::IconDarkMode,   IOSIcons::IconFlashlight, IOSIcons::IconTimer,
+      IOSIcons::IconCalculator, IOSIcons::IconNightShift, IOSIcons::IconBattery,
+      IOSIcons::IconStopwatch,  IOSIcons::IconLock};
+  return k_icons[i];
+}
+
+KDColor ccColor(int i) {
+  switch (i) {
+    case CCAirplane:
+      return rgb(0xFF9F0A);
+    case CCCellular:
+      return rgb(0x30D158);
+    case CCWifi:
+    case CCBluetooth:
+      return rgb(0x0A84FF);
+    case CCFocus:
+      return rgb(0x5E5CE6);
+    case CCRotation:
+      return rgb(0xFF453A);
+    case CCLowPower:
+      return rgb(0xFFD60A);
+    case CCNightShift:
+      return rgb(0xFF9F0A);
+    case CCTimer:
+    case CCStopwatch:
+      return rgb(0xFF9F0A);
+    default:
+      return rgb(0x1C1C1E);
+  }
+}
+
+// Each tile slides in a little after the one above it
+void ccTileAnim(int row, float* offset, int* alpha) {
+  float base = elapsed(s.ccStart, k_ccMs);
+  float t = clamp01((static_cast<float>(now() - s.ccStart) - row * 45) / k_ccMs);
+  if (s.ccClosing) {
+    float e = easeOut(base);
+    *offset = -e * 50.f;
+    *alpha = static_cast<int>((1.f - e) * 256);
+    return;
+  }
+  float e = easeBack(t);
+  *offset = (1.f - e) * -50.f;
+  *alpha = static_cast<int>(clamp01(t * 1.5f) * 256);
+}
+
+int ccRow(int i) {
+  int y = k_cc[i].r.y;
+  return y < k_ccTop + 100 ? 0 : (y < k_ccTop + 150 ? 1 : 2);
+}
+
+Glass ccGlass(int alpha) {
+  Glass g = k_clearGlass;
+  g.tint = rgb(0xFFFFFF);
+  g.tintAlpha = 40;
+  g.highlight = 230;
+  g.alpha = alpha;
+  return g;
+}
+
+void ccSelection(Band& b, Rect r, int radius, int alpha) {
+  roundFrame(b, r.inset(-3), radius + 3, rgb(0xFFFFFF), (230 * alpha) >> 8);
+  roundFrame(b, r.inset(-2), radius + 2, rgb(0xFFFFFF), (90 * alpha) >> 8);
+}
+
+void drawSlider(Band& b, Rect r, float value, uint8_t icon, int alpha,
+                bool selected) {
+  Glass g = ccGlass(alpha);
+  glass(b, r, 20, blurredCapture, g);
+  int h = static_cast<int>(r.h * clamp01(value));
+  Rect level = {r.x, r.bottom() - h, r.w, h};
+  Rect old = b.clip();
+  if (b.setClip(level.intersection(old))) {
+    roundFill(b, r, 20, rgb(0xFFFFFF), alpha);
+  }
+  b.setClip(old);
+  tinted(b, icon, r.x + (r.w - 18) / 2, r.bottom() - 28,
+         value > 0.2f ? rgb(0x3A3A3C) : rgb(0xFFFFFF), alpha);
+  if (selected) {
+    ccSelection(b, r, 20, alpha);
+  }
+}
+
+void drawMusic(Band& b, Rect r, int alpha, bool selected) {
+  Glass g = ccGlass(alpha);
+  glass(b, r, 20, blurredCapture, g);
+  KDColor white = rgb(0xFFFFFF);
+  image(b, IOSIcons::IconAlbum, r.x + 10, r.y + 10, 30, alpha);
+  {
+    // Long titles scroll, like on the phone
+    const char* title = trackTitle(s.music.track);
+    int tw = textWidth(title);
+    int room = r.w - 20;
+    int shift = 0;
+    if (tw > room) {
+      int period = (tw - room) * 40 + 3000;
+      int t = static_cast<int>(now() % period) - 1500;
+      shift = t < 0 ? 0 : (t > (tw - room) * 40 ? tw - room : t / 40);
+    }
+    Rect old = b.clip();
+    if (b.setClip(Rect{r.x + 10, r.y + 44, room, 14}.intersection(old))) {
+      text(b, title, r.x + 10 - shift, r.y + 44, white, Small, Align::Left, 400);
+    }
+    b.setClip(old);
+  }
+  text(b, trackArtist(s.music.track), r.x + 10, r.y + 58, rgb(0xC7C7CC), Small,
+       Align::Left, r.w - 16);
+  // Progress
+  float p = static_cast<float>(s.music.position) / trackLength(s.music.track);
+  roundFill(b, {r.x + 10, r.y + 75, r.w - 20, 3}, 1, white, alpha / 3);
+  roundFill(b, {r.x + 10, r.y + 75, static_cast<int>((r.w - 20) * p), 3}, 1,
+            white, alpha);
+  tinted(b, IOSIcons::IconPrev, r.x + 18, r.y + 82, white, alpha);
+  tinted(b, s.music.playing ? IOSIcons::IconPause : IOSIcons::IconPlay,
+         r.x + 42, r.y + 82, white, alpha);
+  tinted(b, IOSIcons::IconNext, r.x + 66, r.y + 82, white, alpha);
+  if (s.music.playing) {
+    // A small equalizer by the cover
+    uint32_t t = now() / 110;
+    for (int i = 0; i < 4; i++) {
+      int bh = 4 + static_cast<int>((t * (i + 2) * 5 + i * 7) % 14);
+      roundFill(b, {r.right() - 30 + i * 5, r.y + 30 - bh, 3, bh}, 1,
+                rgb(0xFF375F), alpha);
+    }
+  }
+  if (selected) {
+    ccSelection(b, r, 20, alpha);
+  }
+}
+
+void drawCCTile(Band& b, int i, float offset, int alpha) {
+  const CCTile& tile = k_cc[i];
+  Rect r = tile.r.translated(0, static_cast<int>(offset));
+  if (!r.inset(-4).intersects(b.clip())) {
+    return;
+  }
+  bool selected = s.ccSelected == i;
+  bool active = ccActive(i);
+  // Pressed tiles bounce
+  if (s.ccPressed == i && now() - s.ccPressStart < 220) {
+    float t = (now() - s.ccPressStart) / 220.f;
+    int d = static_cast<int>(sinf(t * static_cast<float>(M_PI)) * 3);
+    r = r.inset(d);
+  }
+  KDColor white = rgb(0xFFFFFF);
+  switch (tile.kind) {
+    case 2:
+      drawSlider(b, r, i == CCBrightness ? s.brightnessShown : s.volumeShown,
+                 i == CCBrightness ? IOSIcons::IconSun : IOSIcons::IconSpeaker,
+                 alpha, selected);
+      return;
+    case 3:
+      drawMusic(b, r, alpha, selected);
+      return;
+    case 1: {
+      Glass g = ccGlass(alpha);
+      glass(b, r, 23, blurredCapture, g);
+      int cr = 15;
+      if (active) {
+        disc(b, r.x + 8 + cr, r.y + r.h / 2, cr, white, alpha);
+      } else {
+        Glass inner = k_darkGlass;
+        inner.alpha = alpha;
+        glass(b, {r.x + 8, r.y + r.h / 2 - cr, 2 * cr, 2 * cr}, cr, blurredCapture, inner);
+      }
+      tinted(b, ccIcon(i), r.x + 8 + cr - 9, r.y + r.h / 2 - 9,
+             active ? ccColor(i) : white, alpha);
+      text(b, "Concentration", r.x + 46, r.y + 8, white, Small);
+      text(b, s.focusMode ? "Ne pas deranger" : "Desactive", r.x + 46, r.y + 24,
+           rgb(0xD1D1D6), Small, Align::Left, r.w - 50);
+      if (selected) {
+        ccSelection(b, r, 23, alpha);
+      }
+      return;
+    }
+    default: {
+      int radius = r.w / 2;
+      if (active) {
+        KDColor c = ccColor(i);
+        bool whiteBg = i == CCRotation || i == CCDark || i == CCFlashlight;
+        disc(b, r.x + radius, r.y + r.h / 2, radius, whiteBg ? white : c, alpha);
+        tinted(b, ccIcon(i), r.x + (r.w - 18) / 2, r.y + (r.h - 18) / 2,
+               whiteBg ? (i == CCFlashlight ? rgb(0x1C1C1E) : c) : white, alpha);
+      } else {
+        Glass g = tile.kind == 4 ? k_darkGlass : ccGlass(alpha);
+        g.alpha = alpha;
+        if (tile.kind == 4) {
+          g.tintAlpha = 120;
+        }
+        glass(b, r, radius, blurredCapture, g);
+        tinted(b, ccIcon(i), r.x + (r.w - 18) / 2, r.y + (r.h - 18) / 2, white,
+               alpha);
+      }
+      if (i == CCFlashlight && s.flashlight) {
+        // The beam glows
+        roundFrame(b, r.inset(-2), radius + 2, rgb(0xFFD60A), alpha / 2);
+      }
+      if (selected) {
+        ccSelection(b, r, radius, alpha);
+      }
+      return;
+    }
+  }
+}
+
+const char* ccLabel(int i) {
+  constexpr const char* k_labels[CCCount] = {
+      "Mode Avion",   "Donnees cell.", "Wi-Fi",         "Bluetooth",
+      "Musique",      "Luminosite",    "Volume",        "Concentration",
+      "Rotation",     "Mode sombre",   "Lampe torche",  "Minuteur",
+      "Calculs",      "Night Shift",   "Economie",      "Chronometre",
+      "Verrouiller"};
+  return k_labels[i];
+}
+
+void drawControlCenter(Band& b) {
+  float p = ccProgress();
+  if (p <= 0.f) {
+    return;
+  }
+  captureBackground(b, 110, static_cast<int>(p * 256));
+  KDColor white = rgb(0xFFFFFF);
+  float offset;
+  int alpha;
+  ccTileAnim(0, &offset, &alpha);
+  // Connectivity block behind its four buttons
+  Rect block = k_ccConnect.translated(0, static_cast<int>(offset));
+  if (block.inset(-4).intersects(b.clip())) {
+    glass(b, block, 22, blurredCapture, ccGlass(alpha));
+  }
+  for (int i = 0; i < CCCount; i++) {
+    ccTileAnim(ccRow(i), &offset, &alpha);
+    drawCCTile(b, i, offset, alpha);
+  }
+  // Name of the selected control, at the top
+  ccTileAnim(0, &offset, &alpha);
+  if (Rect{0, 0, k_screenWidth, 26}.intersects(b.clip())) {
+    char pct[8];
+    fmt(pct, sizeof(pct), "%d%%", batteryPercent());
+    text(b, s.airplane ? "Mode Avion" : "iOS-OS 5G", 14, 6 + static_cast<int>(offset / 4), white, Small,
+         Align::Left);
+    text(b, ccLabel(s.ccSelected), 160, 6 + static_cast<int>(offset / 4), white, Small,
+         Align::Center);
+    text(b, pct, 306, 6 + static_cast<int>(offset / 4), white, Small, Align::Right);
+  }
+  // Home indicator: push up to close
+  roundFill(b, {130, 233, 60, 4}, 2, white, alpha * 3 / 4);
+}
+
+/* Spatial navigation between the tiles: the nearest one in the direction,
+ * favouring those that are aligned */
+int ccNeighbour(int from, int dx, int dy) {
+  Rect a = k_cc[from].r;
+  int ax = a.x + a.w / 2, ay = a.y + a.h / 2;
+  int best = -1, bestScore = 1 << 30;
+  for (int i = 0; i < CCCount; i++) {
+    if (i == from) {
+      continue;
+    }
+    Rect r = k_cc[i].r;
+    int bx = r.x + r.w / 2, by = r.y + r.h / 2;
+    int primary = dx != 0 ? (bx - ax) * dx : (by - ay) * dy;
+    if (primary <= 4) {
+      continue;
+    }
+    // Overlap on the other axis counts as aligned
+    int secondary;
+    if (dx != 0) {
+      bool overlap = r.y < a.bottom() && a.y < r.bottom();
+      secondary = overlap ? 0 : (by > ay ? by - ay : ay - by);
+    } else {
+      bool overlap = r.x < a.right() && a.x < r.right();
+      secondary = overlap ? (bx > ax ? bx - ax : ax - bx) / 4 : (bx > ax ? bx - ax : ax - bx);
+    }
+    int score = primary + secondary * 3;
+    if (score < bestScore) {
+      bestScore = score;
+      best = i;
+    }
+  }
+  return best;
+}
+
+void renderUnderCC(Band& b);
+
+void openControlCenter() {
+  if (s.ccOpen && !s.ccClosing) {
+    return;
+  }
+  setAlphaLock(false);
+  // A blurred picture of the screen, seen through the glass
+  s_capturing = true;
+  capture(renderUnderCC);
+  s_capturing = false;
+  s.ccOpen = true;
+  s.ccClosing = false;
+  s.ccStart = now() == 0 ? 1 : now();
+  if (s.ccSelected < 0 || s.ccSelected >= CCCount) {
+    s.ccSelected = CCWifi;
+  }
+  s.brightnessShown = 0.f;
+  s.volumeShown = 0.f;
+  invalidateAll();
+}
+
+void closeControlCenter() {
+  if (!s.ccOpen || s.ccClosing) {
+    return;
+  }
+  s.ccClosing = true;
+  s.ccStart = now() == 0 ? 1 : now();
+  invalidateAll();
+}
+
+void openApplet(Applet a, Rect from);
+
+void ccPress(int i) {
+  s.ccPressed = static_cast<int8_t>(i);
+  s.ccPressStart = now();
+  switch (i) {
+    case CCAirplane:
+      toggleAirplane();
+      break;
+    case CCCellular:
+      s.cellular = !s.cellular;
+      if (s.cellular) {
+        s.airplane = false;
+      }
+      break;
+    case CCWifi:
+      s.wifi = !s.wifi;
+      if (s.wifi) {
+        s.airplane = false;
+      }
+      break;
+    case CCBluetooth:
+      s.bluetooth = !s.bluetooth;
+      if (s.bluetooth) {
+        s.airplane = false;
+      }
+      break;
+    case CCMusic:
+      musicToggle();
+      break;
+    case CCFocus:
+      s.focusMode = !s.focusMode;
+      islandEvent(2);
+      break;
+    case CCRotation:
+      s.rotationLock = !s.rotationLock;
+      break;
+    case CCDark:
+      setDark(!s.dark);
+      // The capture behind changed colours too
+      s_capturing = true;
+      capture(renderUnderCC);
+      s_capturing = false;
+      break;
+    case CCFlashlight:
+      toggleFlashlight();
+      break;
+    case CCNightShift:
+      s.nightShift = !s.nightShift;
+      break;
+    case CCLowPower:
+      toggleLowPower();
+      break;
+    case CCTimer:
+      s.ccOpen = false;
+      s.clockTab = 2;
+      openApplet(Applet::Clock, k_cc[i].r);
+      break;
+    case CCStopwatch:
+      s.ccOpen = false;
+      s.clockTab = 1;
+      openApplet(Applet::Clock, k_cc[i].r);
+      break;
+    case CCCalculator: {
+      s.ccOpen = false;
+      Slot calc = builtinNamed(I18n::Message::CalculApp);
+      if (!calc.isEmpty()) {
+        launchSlot(calc);
+      }
+      break;
+    }
+    case CCLock:
+      s.ccOpen = false;
+      lockScreen();
+      break;
+    default:
+      break;
+  }
+  invalidateAll();
+}
+
+bool ccHandle(Event e) {
+  int sel = s.ccSelected;
+  const CCTile& tile = k_cc[sel];
+  if (e == Events::Back || e == Events::Home || e == Events::Var) {
+    closeControlCenter();
+    return true;
+  }
+  if (tile.kind == 2 && (e == Events::Up || e == Events::Down)) {
+    int dir = e == Events::Up ? 1 : -1;
+    if (sel == CCBrightness) {
+      constexpr int k_step = Ion::Backlight::MaxBrightness / 12;
+      int level = brightness() + dir * k_step;
+      if (level < k_step) {
+        level = k_step;
+      }
+      setBrightness(level);
+    } else {
+      int v = s.volume + dir * 2;
+      s.volume = static_cast<uint8_t>(v < 0 ? 0 : (v > 16 ? 16 : v));
+    }
+    invalidate(tile.r.inset(-5));
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right || e == Events::Up ||
+      e == Events::Down) {
+    int dx = e == Events::Left ? -1 : (e == Events::Right ? 1 : 0);
+    int dy = e == Events::Up ? -1 : (e == Events::Down ? 1 : 0);
+    int n = ccNeighbour(sel, dx, dy);
+    if (n < 0 && dy < 0) {
+      // Pushed up from the top: the control center goes away
+      closeControlCenter();
+      return true;
+    }
+    if (n >= 0) {
+      invalidate(k_cc[sel].r.inset(-5));
+      s.ccSelected = static_cast<int8_t>(n);
+      invalidate(k_cc[n].r.inset(-5));
+      invalidate({0, 0, k_screenWidth, 24});
+    }
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    ccPress(sel);
+    return true;
+  }
+  if (sel == CCMusic && (e == Events::Backspace || e == Events::Toolbox)) {
+    musicSkip(e == Events::Backspace ? 1 : -1);
+    invalidateAll();
+    return true;
+  }
+  return e.isKeyboardEvent() && e != Events::OnOff && e != Events::Shift &&
+         e != Events::Alpha;
+}
+
+/* ============================================================ banners */
+
+void drawBanner(Band& b) {
+  if (!bannerVisible()) {
+    return;
+  }
+  uint32_t t = now() - s.banner.start;
+  float in = easeBack(clamp01(t / 380.f));
+  float out = t > k_bannerMs - 350 ? easeOut((t - (k_bannerMs - 350)) / 350.f) : 0.f;
+  int y = static_cast<int>(-50 + 56 * in - 60 * out);
+  Rect r = {30, y, 260, 44};
+  if (!r.inset(-3).intersects(b.clip())) {
+    return;
+  }
+  Glass g = s.dark ? k_darkGlass : k_clearGlass;
+  g.tintAlpha = s.dark ? 150 : 120;
+  shadow(b, r, 18, 40);
+  Backdrop bd = s.screen == Screen::App ? blurredCapture : blurredWallpaper;
+  if (s.screen == Screen::App) {
+    // No capture of the app: a plain frosted look
+    roundFill(b, r, 18, s.dark ? rgb(0x2C2C2E) : rgb(0xF2F2F7), 235);
+    roundFrame(b, r, 18, rgb(0xFFFFFF), 90);
+  } else {
+    glass(b, r, 18, bd, g);
+  }
+  KDColor tc = s.dark || s.screen != Screen::App ? rgb(0xFFFFFF) : rgb(0x000000);
+  if (s.screen == Screen::App && !s.dark) {
+    tc = rgb(0x000000);
+  }
+  if (s.banner.icon != 255) {
+    roundFill(b, {r.x + 8, r.y + 8, 28, 28}, 8, KDColor::RGB16(s.banner.iconTint));
+    tinted(b, s.banner.icon, r.x + 13, r.y + 13, rgb(0xFFFFFF));
+  }
+  text(b, s.banner.title, r.x + 44, r.y + 6, tc, Small, Align::Left, 200);
+  text(b, s.banner.text, r.x + 44, r.y + 23, tc, Small, Align::Left, 206);
+}
+
+/* ============================================================ everything */
+
+void renderScreen(Band& b) {
+  if (s_loading) {
+    drawLaunch(b);
+    return;
+  }
+  switch (s.screen) {
+    case Screen::Lock:
+      drawLock(b);
+      drawStatusBar(b, false);
+      break;
+    case Screen::Home:
+      drawSpringboard(b);
+      drawStatusBar(b, false);
+      break;
+    case Screen::App:
+      drawAppletScreen(b);
+      drawStatusBar(b, !appletZooming() && Apps::statusDark(s.applet) && !s.dark);
+      break;
+  }
+}
+
+void renderUnderCC(Band& b) { renderScreen(b); }
+
+/* ========================================================== transitions */
+
+void paint(Rect r) {
+  r = r.intersection(k_screen);
+  if (s_painter && !r.isEmpty()) {
+    s_painter(r);
+  }
+}
+
+void paintBetween(Rect inner, Rect outer) {
+  paint({outer.x, outer.y, outer.w, inner.y - outer.y});
+  paint({outer.x, inner.bottom(), outer.w, outer.bottom() - inner.bottom()});
+  paint({outer.x, inner.y, inner.x - outer.x, inner.h});
+  paint({inner.right(), inner.y, outer.right() - inner.right(), inner.h});
+}
+
+bool transitionsEnabled() { return s_painter != nullptr && !s_fakeClock; }
+
+// The launch screen grows out of the icon, then the app opens
+void zoomOpen(Rect from) {
+  constexpr int k_steps = 8;
+  constexpr int k_stepMs = 24;
+  Rect prev = from.intersection(k_screen);
+  paint(prev);
+  uint32_t start = Ion::Timing::millis();
+  for (int i = 1; i <= k_steps; i++) {
+    Rect r = lerpRect(from, k_screen, easeOut(static_cast<float>(i) / k_steps))
+                 .intersection(k_screen);
+    paintBetween(prev, r);
+    prev = r;
+    uint32_t target = start + i * k_stepMs;
+    while (static_cast<uint32_t>(Ion::Timing::millis()) < target) {
+      Ion::Timing::msleep(1);
+    }
+  }
+}
+
+void openApplet(Applet a, Rect from) {
+  setAlphaLock(false);
+  s.applet = a;
+  s.appletFrom = from;
+  s.appletStart = now() == 0 ? 1 : now();
+  s.appletClosing = false;
+  s.screen = Screen::App;
+  Apps::enter(a);
+  invalidateAll();
+}
+
+void closeApplet() {
+  setAlphaLock(false);
+  if (s.screen != Screen::App || s.appletClosing) {
+    return;
+  }
+  s.appletClosing = true;
+  s.appletStart = now() == 0 ? 1 : now();
+  // Back to the icon it was opened from (or the middle of the screen)
+  Rect home = focusRect();
+  if (s.appletFrom.w > k_icon * 2 && s.appletFrom.h > k_icon * 2) {
+    s.appletFrom = {142, 102, 36, 36};
+  } else if (s.appletFrom.y >= k_ccTop && s.appletFrom.w == 46) {
+    s.appletFrom = home;
+  }
+  invalidateAll();
+}
+
+/* ======================================================= the springboard */
+
+void selectFirstOfPage() {
+  s.focus = Focus::Grid;
+  s.row = s.page == 0 ? 0 : 0;
+  s.column = s.page == 0 ? 4 : 0;
+}
+
+void goToPage(int page, bool fromRight) {
+  int n = numberOfPages();
+  if (page < 0 || page >= n) {
+    return;
+  }
+  s.page = static_cast<int8_t>(page);
+  s.column = static_cast<int8_t>(fromRight ? k_columns - 1 : 0);
+  // The nearest filled cell
+  while (cellContent(s.page, s.column, s.row) == k_cellEmpty && (s.row > 0 || s.column > 0)) {
+    if (s.column > 0) {
+      s.column--;
+    } else {
+      s.row--;
+      s.column = k_columns - 1;
+    }
+  }
+}
+
+bool moveGrid(int dx, int dy) {
+  int content = cellContent(s.page, s.column, s.row);
+  if (dx != 0) {
+    int col = s.column + dx;
+    // Jump over the rest of the widget
+    while (col >= 0 && col < k_columns && content < -1 &&
+           cellContent(s.page, col, s.row) == content) {
+      col += dx;
+    }
+    if (col < 0) {
+      if (s.page > 0) {
+        goToPage(s.page - 1, true);
+        if (cellContent(s.page, s.column, s.row) == k_cellEmpty) {
+          s.row = 0;
+        }
+      }
+      return true;
+    }
+    if (col >= k_columns || cellContent(s.page, col, s.row) == k_cellEmpty) {
+      if (s.page + 1 < numberOfPages()) {
+        int row = s.row;
+        goToPage(s.page + 1, false);
+        s.row = static_cast<int8_t>(row);
+        s.column = 0;
+        while (s.row > 0 && cellContent(s.page, s.column, s.row) == k_cellEmpty) {
+          s.row--;
+        }
+      }
+      return true;
+    }
+    s.column = static_cast<int8_t>(col);
+    return true;
+  }
+  int row = s.row + dy;
+  while (row >= 0 && row < k_rows && content < -1 &&
+         cellContent(s.page, s.column, row) == content) {
+    row += dy;
+  }
+  if (row < 0) {
+    return false;  // pulled down from the top: control center
+  }
+  if (row >= k_rows || cellContent(s.page, s.column, row) == k_cellEmpty) {
+    if (dy > 0) {
+      s.focus = Focus::Dock;
+      int d = s.column * k_dockSize / k_columns;
+      s.dockIndex = static_cast<int8_t>(d >= k_dockSize ? k_dockSize - 1 : d);
+    }
+    return true;
+  }
+  s.row = static_cast<int8_t>(row);
+  return true;
+}
+
+bool handleSpringboard(Event e) {
+  if (e == Events::Home || e == Events::Back) {
+    if (s.page != 0 || s.focus != Focus::Grid) {
+      s.page = 0;
+      selectFirstOfPage();
+      touchSelection();
+      invalidateAll();
+    }
+    return true;
+  }
+  if (e == Events::Left || e == Events::Right || e == Events::Up ||
+      e == Events::Down) {
+    int dx = e == Events::Left ? -1 : (e == Events::Right ? 1 : 0);
+    int dy = e == Events::Up ? -1 : (e == Events::Down ? 1 : 0);
+    int oldPage = s.page;
+    Rect oldDirty = focusDirty();
+    if (s.focus == Focus::Dock) {
+      if (dy < 0) {
+        s.focus = Focus::Grid;
+        s.row = k_rows - 1;
+        int col = s.dockIndex * k_columns / k_dockSize + (s.dockIndex >= 2 ? 1 : 0);
+        s.column = static_cast<int8_t>(col >= k_columns ? k_columns - 1 : col);
+        while (cellContent(s.page, s.column, s.row) == k_cellEmpty &&
+               (s.row > 0 || s.column > 0)) {
+          if (s.column > 0) {
+            s.column--;
+          } else {
+            s.row--;
+            s.column = k_columns - 1;
+          }
+        }
+      } else if (dx != 0) {
+        int d = s.dockIndex + dx;
+        if (d >= 0 && d < k_dockSize) {
+          s.dockIndex = static_cast<int8_t>(d);
+        }
+      }
+    } else if (!moveGrid(dx, dy)) {
+      openControlCenter();
+      return true;
+    }
+    touchSelection();
+    if (s.page == oldPage) {
+      // Only the old and the new selection change
+      invalidate(oldDirty);
+      invalidate(focusDirty());
+    } else {
+      invalidateAll();
+    }
+    return true;
+  }
+  if (e == Events::OK || e == Events::EXE) {
+    launchSlot(selectedSlot());
+    return true;
+  }
+  return e.isKeyboardEvent() && e != Events::OnOff && e != Events::Shift &&
+         e != Events::Alpha;
+}
+
+void unlock() {
+  if (s.screen != Screen::Lock || unlocking()) {
+    return;
+  }
+  s.unlockStart = now() == 0 ? 1 : now();
+  s.introStart = s.unlockStart + 120;
+  invalidateAll();
+}
+
+}  // namespace
+
+void lockScreen() {
+  s.screen = Screen::Lock;
+  s.unlockStart = 0;
+  s.ccOpen = false;
+  setAlphaLock(false);
+  invalidateAll();
+}
+
+void launchSlot(Slot slot) {
+  if (slot.isEmpty()) {
+    return;
+  }
+  if (slot.kind == Slot::Kind::Applet) {
+    Rect from = s.screen == Screen::Home ? focusRect() : Rect{142, 102, 36, 36};
+    openApplet(static_cast<Applet>(slot.index), from);
+    return;
+  }
+  if (transitionsEnabled()) {
+    Rect from = s.screen == Screen::Home ? focusRect() : Rect{142, 102, 36, 36};
+    s_loading = true;
+    s_loadingSlot = slot;
+    zoomOpen(from);
+  }
+  s_launch = {slot.kind == Slot::Kind::Builtin ? Item::Kind::Builtin
+                                               : Item::Kind::External,
+              slot.index};
+}
