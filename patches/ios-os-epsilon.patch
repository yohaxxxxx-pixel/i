+def squircle_mask(c, inset=0):
+    """A superellipse, closer to the real icon shape than a rounded square."""
+    mask = Image.new("L", (c.n, c.n), 0)
+    n = 5.0
+    r = c.n / 2 - c.s(inset)
+    pts = []
+    for i in range(720):
+        a = i / 720 * 2 * math.pi
+        ca, sa = math.cos(a), math.sin(a)
+        x = abs(ca) ** (2 / n) * r * (1 if ca >= 0 else -1)
+        y = abs(sa) ** (2 / n) * r * (1 if sa >= 0 else -1)
+        pts.append((c.n / 2 + x, c.n / 2 + y))
+    ImageDraw.Draw(mask).polygon(pts, fill=255)
+    return mask
+
+
+def gradient_bg(c, top, bottom):
+    grad = Image.new("RGBA", (c.n, c.n))
+    t = hexc(top)
+    b = hexc(bottom)
+    for y in range(c.n):
+        k = y / (c.n - 1)
+        col = tuple(int(t[i] + (b[i] - t[i]) * k) for i in range(4))
+        grad.paste(col, (0, y, c.n, y + 1))
+    c.img.paste(grad, (0, 0), squircle_mask(c))
+
+
+def finish(c):
+    """Clip everything to the squircle, plus a faint top light."""
+    light = Image.new("RGBA", (c.n, c.n), CLEAR)
+    ld = ImageDraw.Draw(light)
+    for i in range(40):
+        a = int(26 * (1 - i / 40))
+        ld.rectangle([0, c.s(i), c.n, c.s(i + 1)], fill=(255, 255, 255, a))
+    c.img.alpha_composite(light)
+    alpha = c.img.getchannel("A")
+    alpha = Image.composite(alpha, Image.new("L", (c.n, c.n), 0), squircle_mask(c))
+    c.img.putalpha(alpha)
+
