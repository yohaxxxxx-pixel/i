+/* ============================================================== Clock */
+
+constexpr const char* k_clockTabs[] = {"Horloge", "Chrono", "Minuteur"};
+
+void drawSegmented(Band& b, int y) {
+  const Theme& t = theme();
+  Rect r = {50, y, 220, 22};
+  roundFill(b, r, 11, t.dark ? rgb(0x2C2C2E) : rgb(0xE3E3E8));
+  int x = r.x + 2 + static_cast<int>(s.clockTabShown * 72);
+  Rect pill = {x, y + 2, 72, 18};
+  roundFill(b, pill, 9, t.dark ? rgb(0x636366) : rgb(0xFFFFFF));
+  for (int i = 0; i < 3; i++) {
+    text(b, k_clockTabs[i], r.x + 2 + i * 72 + 36, y + 4, t.text, Small,
+         Align::Center);
+  }
+}
+
+struct City {
+  const char* name;
+  int offsetHours;
+};
+constexpr City k_cities[] = {
+    {"Paris", 0}, {"New York", -6}, {"Tokyo", 8}, {"Sydney", 10}};
+
+void drawAnalogClock(Band& b, int cx, int cy, int r) {
+  const Theme& t = theme();
+  if (!Rect{cx - r - 2, cy - r - 2, 2 * r + 4, 2 * r + 4}.intersects(b.clip())) {
+    return;
+  }
+  disc(b, cx, cy, r, t.card);
+  for (int i = 0; i < 60; i++) {
+    float a = i / 60.f * 2.f * static_cast<float>(M_PI);
+    float r0 = i % 5 == 0 ? r - 9.f : r - 5.f;
+    line(b, cx + r0 * sinf(a), cy - r0 * cosf(a), cx + (r - 3.f) * sinf(a),
+         cy - (r - 3.f) * cosf(a), i % 5 == 0 ? 2.f : 1.f,
+         i % 5 == 0 ? t.text : t.secondary);
+  }
+  constexpr const char* k_nums[] = {"12", "3", "6", "9"};
+  for (int i = 0; i < 4; i++) {
+    float a = i / 4.f * 2.f * static_cast<float>(M_PI);
+    int nx = cx + static_cast<int>((r - 20) * sinf(a));
+    int ny = cy - static_cast<int>((r - 20) * cosf(a)) - 7;
+    text(b, k_nums[i], nx, ny, t.text, Small, Align::Center);
+  }
+  float sec = clockSeconds() + (now() % 1000) / 1000.f;
+  float ha = fmodf(sec, 43200.f) / 43200.f * 2.f * static_cast<float>(M_PI);
+  float ma = fmodf(sec, 3600.f) / 3600.f * 2.f * static_cast<float>(M_PI);
+  float sa = fmodf(sec, 60.f) / 60.f * 2.f * static_cast<float>(M_PI);
+  line(b, cx, cy, cx + r * 0.5f * sinf(ha), cy - r * 0.5f * cosf(ha), 4.f, t.text);
+  line(b, cx, cy, cx + r * 0.78f * sinf(ma), cy - r * 0.78f * cosf(ma), 3.f, t.text);
+  line(b, cx - r * 0.15f * sinf(sa), cy + r * 0.15f * cosf(sa),
+       cx + r * 0.85f * sinf(sa), cy - r * 0.85f * cosf(sa), 1.4f, t.orange);
+  disc(b, cx, cy, 4, t.orange);
+  disc(b, cx, cy, 1, t.card);
+}
+
+void drawWorldClock(Band& b) {
+  const Theme& t = theme();
+  drawAnalogClock(b, 82, 140, 66);
+  int minutes = clockMinutes();
+  for (int i = 0; i < 4; i++) {
+    Rect r = {164, 54 + i * 44, 146, 40};
+    if (!r.intersects(b.clip())) {
+      continue;
+    }
+    roundFill(b, r, 10, t.card);
+    int m = minutes + k_cities[i].offsetHours * 60;
+    const char* day = m < 0 ? "Hier" : (m >= 1440 ? "Demain" : "Aujourd'hui");
+    m = (m % 1440 + 1440) % 1440;
+    char clock[8];
+    clockText(clock, sizeof(clock), m);
+    char offset[24];
+    if (k_cities[i].offsetHours == 0) {
+      fmt(offset, sizeof(offset), "%s", "Ici");
+    } else {
+      fmt(offset, sizeof(offset), "%s %+dh", day[0] == 'A' ? "" : day,
+          k_cities[i].offsetHours);
+    }
+    text(b, k_cities[i].name, r.x + 8, r.y + 4, t.text, Small);
+    // Day or night
+    bool night = m < 7 * 60 || m >= 19 * 60;
+    disc(b, r.x + 12, r.y + 28, 4, night ? rgb(0x5E5CE6) : rgb(0xFFCC00));
+    text(b, offset, r.x + 21, r.y + 21, t.secondary, Small, Align::Left, 70);
+    digits(b, clock, r.right() - 8, r.y + 11, 18, t.text, Align::Right);
+  }
+}
+
+uint32_t chronoMs() {
+  return s.chrono.accumulated + (s.chrono.running ? now() - s.chrono.start : 0);
+}
+
+void chronoText(uint32_t ms, char* buffer, int size) {
+  fmt(buffer, size, "%02d:%02d,%02d", static_cast<int>(ms / 60000),
+      static_cast<int>((ms / 1000) % 60), static_cast<int>((ms / 10) % 100));
+}
+
+void roundButton(Band& b, int cx, int cy, const char* label, KDColor fg,
+                 KDColor bg) {
+  disc(b, cx, cy, 28, bg);
+  roundFrame(b, {cx - 31, cy - 31, 62, 62}, 31, bg, 160);
+  text(b, label, cx, cy - 7, fg, Small, Align::Center);
+}
+
+void drawChrono(Band& b) {
+  const Theme& t = theme();
+  char buffer[16];
+  chronoText(chronoMs(), buffer, sizeof(buffer));
+  digits(b, buffer, 160, 54, 40, t.text, Align::Center);
+  bool running = s.chrono.running;
+  bool zero = chronoMs() == 0;
+  roundButton(b, 64, 140, running || zero ? "Tour" : "Effacer", t.text,
+              t.dark ? rgb(0x333333) : rgb(0xDADADF));
+  roundButton(b, 256, 140, running ? "Arreter" : "Demarrer",
+              running ? t.red : t.green,
+              running ? rgb(0x4A1A18) : rgb(0x0F3B1A));
+  for (int i = 0; i < s.chrono.numberOfLaps; i++) {
+    int y = 112 + i * 26;
+    Rect r = {108, y, 104, 24};
+    if (!r.intersects(b.clip())) {
+      continue;
+    }
+    char lap[24];
+    fmt(lap, sizeof(lap), "Tour %d", s.chrono.numberOfLaps - i);
+    text(b, lap, r.x, r.y + 4, t.secondary, Small);
+    chronoText(s.chrono.laps[i], buffer, sizeof(buffer));
+    text(b, buffer, r.right() + 4, r.y + 4, t.text, Small, Align::Right);
+  }
+  text(b, "OK : demarrer/arreter   <x : tour", 160, 220, t.secondary, Small,
+       Align::Center);
+}
+
+uint32_t timerRemaining() {
+  if (!s.timer.running) {
+    return s.timer.seconds * 1000u;
+  }
+  if (s.timer.paused) {
+    return s.timer.remaining;
+  }
+  return s.timer.end > now() ? s.timer.end - now() : 0;
+}
+
+void drawTimer(Band& b) {
+  const Theme& t = theme();
+  int cx = 104, cy = 136;
+  uint32_t rem = timerRemaining();
+  float frac = s.timer.running ? rem / (s.timer.seconds * 1000.f) : 1.f;
+  ring(b, cx, cy, 70, 8, 1.f, t.dark ? rgb(0x3A3A3C) : rgb(0xE3E3E8));
+  ring(b, cx, cy, 70, 8, frac, t.orange);
+  char buffer[16];
+  uint32_t secs = (rem + 999) / 1000;
+  fmt(buffer, sizeof(buffer), "%d:%02d", static_cast<int>(secs / 60),
+      static_cast<int>(secs % 60));
+  digits(b, buffer, cx, cy - 22, 32, t.text, Align::Center);
+  text(b, s.timer.running ? (s.timer.paused ? "En pause" : "En cours") : "Haut / bas",
+       cx, cy + 20, t.secondary, Small, Align::Center);
+  roundButton(b, 250, 92, "Annuler", t.text, t.dark ? rgb(0x333333) : rgb(0xDADADF));
+  const char* label = !s.timer.running ? "Demarrer" : (s.timer.paused ? "Reprendre" : "Pause");
+  roundButton(b, 250, 176, label, s.timer.running && !s.timer.paused ? t.orange : t.green,
+              s.timer.running && !s.timer.paused ? rgb(0x46310F) : rgb(0x0F3B1A));
+}
+
+void clockRender(Band& b) {
+  background(b);
+  drawSegmented(b, k_top + 4);
+  switch (s.clockTab) {
+    case 0:
+      drawWorldClock(b);
+      break;
+    case 1:
+      drawChrono(b);
+      break;
+    default:
+      drawTimer(b);
+      break;
+  }
+}
+
+void startTimer() {
+  s.timer.running = true;
+  s.timer.paused = false;
+  s.timer.end = now() + s.timer.seconds * 1000u;
+}
+
+bool clockHandle(Event e) {
+  if (e == Events::Left && s.clockTab > 0) {
+    s.clockTab--;
+  } else if (e == Events::Right && s.clockTab < 2) {
+    s.clockTab++;
+  } else if (s.clockTab == 1 && (e == Events::OK || e == Events::EXE)) {
+    if (s.chrono.running) {
+      s.chrono.accumulated += now() - s.chrono.start;
+      s.chrono.running = false;
+    } else {
+      s.chrono.start = now();
+      s.chrono.running = true;
+    }
+  } else if (s.clockTab == 1 && (e == Events::Backspace || e == Events::Toolbox)) {
+    if (s.chrono.running) {
+      for (int i = ChronoState::k_laps - 1; i > 0; i--) {
+        s.chrono.laps[i] = s.chrono.laps[i - 1];
+      }
+      s.chrono.laps[0] = chronoMs();
+      if (s.chrono.numberOfLaps < ChronoState::k_laps) {
+        s.chrono.numberOfLaps++;
+      }
+    } else {
+      s.chrono.accumulated = 0;
+      s.chrono.numberOfLaps = 0;
+    }
+  } else if (s.clockTab == 2 && (e == Events::Up || e == Events::Down)) {
+    if (!s.timer.running) {
+      int step = e == Events::Up ? 60 : -60;
+      int v = s.timer.seconds + step;
+      s.timer.seconds = static_cast<uint16_t>(v < 60 ? 60 : (v > 99 * 60 ? 99 * 60 : v));
+    }
+  } else if (s.clockTab == 2 && (e == Events::OK || e == Events::EXE)) {
+    if (!s.timer.running) {
+      startTimer();
+    } else if (s.timer.paused) {
+      s.timer.end = now() + s.timer.remaining;
+      s.timer.paused = false;
+    } else {
+      s.timer.remaining = timerRemaining();
+      s.timer.paused = true;
+    }
+  } else if (s.clockTab == 2 && (e == Events::Backspace || e == Events::Toolbox)) {
+    s.timer.running = false;
+    s.timer.paused = false;
+  } else {
+    return false;
+  }
+  invalidateAll();
+  return true;
+}
+
+bool clockFrame() {
+  bool moving = approach(&s.clockTabShown, s.clockTab);
+  if (moving) {
+    invalidateAll();
+    return true;
+  }
+  switch (s.clockTab) {
+    case 0:
+      invalidate({14, 72, 138, 138});
+      return true;
+    case 1:
+      if (s.chrono.running) {
+        invalidate({0, 54, k_screenWidth, 50});
+        return true;
+      }
+      return false;
+    default:
+      if (s.timer.running && !s.timer.paused) {
+        invalidate({24, 56, 162, 162});
+        return true;
+      }
+      return false;
+  }
+}
+
+/* ============================================================ Weather */
+
+struct Forecast {
+  const char* city;
+  int temp, high, low;
+  uint8_t kind;  // 0 sun, 1 clouds, 2 rain, 3 clear night
+  const char* label;
+};
+
+constexpr Forecast k_forecasts[] = {
+    {"Paris", 14, 17, 9, 1, "Nuageux"},
+    {"Lyon", 11, 13, 7, 2, "Pluie"},
+    {"Marseille", 19, 21, 13, 0, "Ensoleille"},
+    {"Tokyo", 9, 12, 5, 3, "Degage"},
+};
+constexpr int k_numberOfForecasts = sizeof(k_forecasts) / sizeof(Forecast);
+
+uint32_t s_skyTop = 0x3A8EE6, s_skyBottom = 0x9BCBF5;
+
+void skyColors(int kind, uint32_t* top, uint32_t* bottom) {
+  switch (kind) {
+    case 0:
+      *top = 0x2E86F0;
+      *bottom = 0x8CCBFF;
+      break;
+    case 1:
+      *top = 0x5A7189;
+      *bottom = 0xA9B8C7;
+      break;
+    case 2:
+      *top = 0x2F3B4B;
+      *bottom = 0x5E6E80;
+      break;
+    default:
+      *top = 0x0B1030;
+      *bottom = 0x2B3A78;
+      break;
+  }
+}
+
+KDColor skyAt(int x, int y) {
+  (void)x;
+  return mix(s_skyTop, s_skyBottom, y * 256 / k_screenHeight);
+}
+
+void drawSky(Band& b) {
+  const Rect& z = b.clip();
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor c = skyAt(0, y);
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      row[x] = c;
+    }
+  }
+}
+
+void cloud(Band& b, int x, int y, float k, KDColor c, int alpha) {
+  disc(b, x + static_cast<int>(8 * k), y + static_cast<int>(10 * k), static_cast<int>(6 * k), c, alpha);
+  disc(b, x + static_cast<int>(16 * k), y + static_cast<int>(7 * k), static_cast<int>(8 * k), c, alpha);
+  disc(b, x + static_cast<int>(24 * k), y + static_cast<int>(11 * k), static_cast<int>(5 * k), c, alpha);
+  roundFill(b, {x + static_cast<int>(3 * k), y + static_cast<int>(10 * k), static_cast<int>(26 * k), static_cast<int>(7 * k)},
+            static_cast<int>(3 * k), c, alpha);
+}
+
+void weatherIcon(Band& b, int kind, int x, int y, float k) {
+  KDColor white = rgb(0xFFFFFF);
+  switch (kind) {
+    case 0:
+      disc(b, x + static_cast<int>(14 * k), y + static_cast<int>(12 * k), static_cast<int>(7 * k), rgb(0xFFD60A));
+      break;
+    case 1:
+      disc(b, x + static_cast<int>(10 * k), y + static_cast<int>(8 * k), static_cast<int>(6 * k), rgb(0xFFD60A));
+      cloud(b, x, y + static_cast<int>(2 * k), k * 0.9f, white, 256);
+      break;
+    case 2:
+      cloud(b, x, y, k * 0.9f, rgb(0xD1D1D6), 256);
+      for (int i = 0; i < 3; i++) {
+        line(b, x + (8 + i * 7) * k, y + 19 * k, x + (6 + i * 7) * k, y + 24 * k, 1.5f, rgb(0x64D2FF));
+      }
+      break;
+    default:
+      disc(b, x + static_cast<int>(14 * k), y + static_cast<int>(12 * k), static_cast<int>(7 * k), rgb(0xF2F2F7));
+      disc(b, x + static_cast<int>(17 * k), y + static_cast<int>(10 * k), static_cast<int>(6 * k), s.dark ? rgb(0x1B2350) : rgb(0x1B2350));
+      break;
+  }
+}
+
+void drawWeatherCity(Band& b, int index, int ox) {
+  const Forecast& f = k_forecasts[index];
+  KDColor white = rgb(0xFFFFFF);
+  uint32_t t = now();
+  // Animated sky
+  if (f.kind == 0) {
+    float a0 = t / 2000.f;
+    for (int i = 0; i < 10; i++) {
+      float a = a0 + i * 0.6283f;
+      line(b, ox + 262 + 26 * cosf(a), 54 + 26 * sinf(a), ox + 262 + 36 * cosf(a),
+           54 + 36 * sinf(a), 3.f, rgb(0xFFE066), 200);
+    }
+    disc(b, ox + 262, 54, 20, rgb(0xFFD60A));
+  } else if (f.kind == 3) {
+    for (int i = 0; i < 24; i++) {
+      int sx = ox + (i * 97) % 320, sy = 24 + (i * 53) % 110;
+      int tw = static_cast<int>(128 + 127 * sinf(t / 300.f + i));
+      fill(b, {sx, sy, 2, 2}, white, tw);
+    }
+    disc(b, ox + 262, 54, 16, rgb(0xF2F2F7));
+    disc(b, ox + 270, 48, 14, rgb(0x0F1640));
+  }
+  if (f.kind == 1 || f.kind == 2) {
+    for (int i = 0; i < 3; i++) {
+      int cx = ox + static_cast<int>(fmodf(t / (40.f + i * 15) + i * 120, 400.f)) - 60;
+      cloud(b, cx, 34 + i * 26, 1.6f + i * 0.3f, white, f.kind == 2 ? 70 : 110);
+    }
+  }
+  if (f.kind == 2) {
+    for (int i = 0; i < 40; i++) {
+      int rx = ox + (i * 71) % 320;
+      int ry = static_cast<int>((t / 4 + i * 37) % 240);
+      line(b, rx, ry, rx - 2, ry + 7, 1.2f, rgb(0xB0D8FF), 150);
+    }
+  }
+  text(b, f.city, ox + 160, 24, white, Large, Align::Center);
+  char buffer[24];
+  fmt(buffer, sizeof(buffer), "%d\xC2\xB0", f.temp);
+  digits(b, buffer, ox + 166, 44, 42, white, Align::Center);
+  text(b, f.label, ox + 160, 92, white, Small, Align::Center);
+  fmt(buffer, sizeof(buffer), "H:%d\xC2\xB0  B:%d\xC2\xB0", f.high, f.low);
+  text(b, buffer, ox + 160, 108, white, Small, Align::Center);
+  // Hourly forecast, in liquid glass over the sky
+  Rect card = {ox + 10, 128, 300, 54};
+  if (card.inset(-2).intersects(b.clip())) {
+    Glass g = k_clearGlass;
+    g.tintAlpha = 50;
+    glass(b, card, 16, skyAt, g);
+    int hour = clockMinutes() / 60;
+    for (int i = 0; i < 6; i++) {
+      int cx = card.x + 26 + i * 50;
+      char h[8];
+      if (i == 0) {
+        fmt(h, sizeof(h), "Main.");
+      } else {
+        fmt(h, sizeof(h), "%dh", (hour + i) % 24);
+      }
+      text(b, h, cx, card.y + 4, white, Small, Align::Center);
+      int kind = f.kind;
+      int hh = (hour + i) % 24;
+      if (kind == 0 && (hh < 7 || hh > 19)) {
+        kind = 3;
+      }
+      if (kind == 1 && i % 3 == 2) {
+        kind = 0;
+      }
+      weatherIcon(b, kind, cx - 14, card.y + 18, 0.9f);
+      fmt(h, sizeof(h), "%d\xC2\xB0", f.temp + (i < 3 ? i / 2 : 2 - i / 2));
+      text(b, h, cx, card.y + 38, white, Small, Align::Center);
+    }
+  }
+  // Next days
+  Rect days = {ox + 10, 188, 300, 44};
+  if (days.inset(-2).intersects(b.clip())) {
+    Glass g = k_clearGlass;
+    g.tintAlpha = 50;
+    glass(b, days, 16, skyAt, g);
+    Date d = today();
+    for (int i = 0; i < 3; i++) {
+      int x = days.x + 12 + i * 98;
+      char label[24];
+      const char* wd = weekdayName((d.weekday + i + 1) % 7);
+      fmt(label, sizeof(label), "%c%c%c", wd[0] - 32, wd[1], wd[2]);
+      text(b, label, x, days.y + 6, white, Small);
+      weatherIcon(b, (f.kind + i + 1) % 3, x + 30, days.y + 6, 0.7f);
+      fmt(label, sizeof(label), "%d/%d", f.high - i + 1, f.low + i - 1);
+      text(b, label, x + 4, days.y + 24, rgb(0xE5E5EA), Small);
+    }
+  }
+}
+
+void weatherRender(Band& b) {
+  int i = static_cast<int>(floorf(s.weatherShown));
+  float frac = s.weatherShown - i;
+  uint32_t t0, b0, t1, b1;
+  skyColors(k_forecasts[i].kind, &t0, &b0);
+  int j = i + 1 < k_numberOfForecasts ? i + 1 : i;
+  skyColors(k_forecasts[j].kind, &t1, &b1);
+  int k = static_cast<int>(frac * 256);
+  KDColor ct = mix(t0, t1, k), cb = mix(b0, b1, k);
+  s_skyTop = (ct.red() << 16) | (ct.green() << 8) | ct.blue();
+  s_skyBottom = (cb.red() << 16) | (cb.green() << 8) | cb.blue();
+  drawSky(b);
+  int ox = -static_cast<int>(frac * k_screenWidth);
+  drawWeatherCity(b, i, ox);
+  if (frac > 0.001f && j != i) {
+    drawWeatherCity(b, j, ox + k_screenWidth);
+  }
+  // Page dots
+  for (int c = 0; c < k_numberOfForecasts; c++) {
+    disc(b, 160 - (k_numberOfForecasts - 1) * 5 + c * 10, 236, 2, rgb(0xFFFFFF),
+         c == s.weatherCity ? 256 : 110);
+  }
+}
+
+bool weatherHandle(Event e) {
+  if (e == Events::Left && s.weatherCity > 0) {
+    s.weatherCity--;
+  } else if (e == Events::Right && s.weatherCity < k_numberOfForecasts - 1) {
+    s.weatherCity++;
+  } else {
+    return false;
+  }
+  invalidateAll();
+  return true;
+}
+
+bool weatherFrame() {
+  approach(&s.weatherShown, s.weatherCity, 0.3f);
+  invalidateAll();
+  return true;
+}
+
+/* =========================================================== Calendar */
+
+struct Holiday {
+  int day, month;
+  const char* name;
+};
+constexpr Holiday k_holidays[] = {
+    {1, 1, "Jour de l'an"},      {14, 2, "Saint-Valentin"},
+    {14, 3, "Journee de Pi"},    {1, 5, "Fete du travail"},
+    {8, 5, "Victoire 1945"},     {21, 6, "Fete de la musique"},
+    {14, 7, "Fete nationale"},   {15, 8, "Assomption"},
+    {1, 11, "Toussaint"},        {11, 11, "Armistice"},
+    {25, 12, "Noel"},            {31, 12, "Reveillon"},
+};
+
+const char* holiday(int day, int month) {
+  for (const Holiday& h : k_holidays) {
+    if (h.day == day && h.month == month) {
+      return h.name;
+    }
+  }
+  return nullptr;
+}
+
+void drawMonth(Band& b, int year, int month, int ox) {
+  const Theme& t = theme();
+  Date now_ = today();
+  int first = dateFromDays(daysFromDate(year, month, 1)).weekday;
+  int dim = daysInMonth(year, month);
+  constexpr const char* k_wd[] = {"L", "M", "M", "J", "V", "S", "D"};
+  for (int i = 0; i < 7; i++) {
+    text(b, k_wd[i], ox + 25 + i * 30, 52, i >= 5 ? t.secondary : t.text, Small,
+         Align::Center);
+  }
+  fill(b, {ox + 10, 68, 210, 1}, t.separator);
+  for (int d = 1; d <= dim; d++) {
+    int cell = first + d - 1;
+    int cx = ox + 25 + (cell % 7) * 30;
+    int cy = 84 + (cell / 7) * 26;
+    if (!Rect{cx - 13, cy - 13, 26, 26}.intersects(b.clip())) {
+      continue;
+    }
+    bool isToday = year == now_.year && month == now_.month && d == now_.day;
+    bool selected = year == s.calendar.year && month == s.calendar.month && d == s.calendar.day;
+    KDColor c = (cell % 7) >= 5 ? t.secondary : t.text;
+    if (selected) {
+      disc(b, cx, cy, 12, isToday ? t.red : t.text);
+      c = isToday || !t.dark ? rgb(0xFFFFFF) : rgb(0x000000);
+    } else if (isToday) {
+      c = t.red;
+    }
+    char buffer[4];
+    fmt(buffer, sizeof(buffer), "%d", d);
+    text(b, buffer, cx, cy - 7, c, Small, Align::Center);
+    if (holiday(d, month)) {
+      disc(b, cx, cy + 9, 1, t.secondary);
+    }
+  }
+}
+
+void calendarRender(Band& b) {
+  background(b);
+  const Theme& t = theme();
+  CalendarUI& c = s.calendar;
+  char title[32];
+  fmt(title, sizeof(title), "%s %d", monthName(c.month), c.year);
+  title[0] = title[0] - 32;
+  scaledText(b, title, 14, k_top + 4, t.red, 80);
+  int ox = static_cast<int>(c.slide * k_screenWidth);
+  Rect old = b.clip();
+  if (b.setClip(Rect{0, 40, 226, 200}.intersection(old))) {
+    drawMonth(b, c.year, c.month, ox);
+  }
+  b.setClip(old);
+  // The selected day
+  Rect card = {228, 46, 84, 186};
+  roundFill(b, card, 14, t.card);
+  Date d = dateFromDays(daysFromDate(c.year, c.month, c.day));
+  text(b, weekdayName(d.weekday), card.x + card.w / 2, card.y + 8, t.red, Small,
+       Align::Center);
+  char day[4];
+  fmt(day, sizeof(day), "%d", c.day);
+  digits(b, day, card.x + card.w / 2, card.y + 28, 34, t.text, Align::Center);
+  text(b, monthName(c.month), card.x + card.w / 2, card.y + 72, t.secondary,
+       Small, Align::Center);
+  fill(b, {card.x + 8, card.y + 94, card.w - 16, 1}, t.separator);
+  const char* h = holiday(c.day, c.month);
+  if (h) {
+    roundFill(b, {card.x + 6, card.y + 102, 3, 30}, 1, t.red);
+    text(b, h, card.x + 14, card.y + 102, t.text, Small, Align::Left, card.w - 18);
+    text(b, "Ferie", card.x + 14, card.y + 118, t.secondary, Small);
+  } else {
+    text(b, "Aucun", card.x + card.w / 2, card.y + 106, t.secondary, Small, Align::Center);
+    text(b, "evenement", card.x + card.w / 2, card.y + 122, t.secondary, Small,
+         Align::Center);
+  }
+}
+
+bool calendarHandle(Event e) {
+  CalendarUI& c = s.calendar;
+  int delta = e == Events::Left ? -1 : e == Events::Right ? 1 : e == Events::Up ? -7 : e == Events::Down ? 7 : 0;
+  if (delta == 0) {
+    if (e == Events::OK || e == Events::EXE) {
+      Date d = today();
+      c.year = static_cast<int16_t>(d.year);
+      c.month = static_cast<int8_t>(d.month);
+      c.day = static_cast<int8_t>(d.day);
+      invalidateAll();
+      return true;
+    }
+    return false;
+  }
+  int oldMonth = c.month;
+  Date d = dateFromDays(daysFromDate(c.year, c.month, c.day) + delta);
+  if (d.month != oldMonth) {
+    c.slide = delta > 0 ? 1.f : -1.f;
+  }
+  c.year = static_cast<int16_t>(d.year);
+  c.month = static_cast<int8_t>(d.month);
+  c.day = static_cast<int8_t>(d.day);
+  invalidateAll();
+  return true;
+}
+
+bool calendarFrame() {
+  if (approach(&s.calendar.slide, 0.f, 0.3f)) {
+    invalidateAll();
+    return true;
+  }
+  return false;
+}
+
+/* ============================================================== Notes */
+
+void noteTitle(const char* text_, char* out, int size, int line) {
+  // Line number line of the note (0: title)
+  const char* p = text_;
+  for (int i = 0; i < line && *p; i++) {
+    const char* nl = strchr(p, '\n');
+    if (!nl) {
+      p = p + strlen(p);
+      break;
+    }
+    p = nl + 1;
+  }
+  int n = 0;
+  while (p[n] && p[n] != '\n' && n < size - 1) {
+    out[n] = p[n];
+    n++;
+  }
+  out[n] = 0;
+}
+
+void drawNoteList(Band& b) {
+  const Theme& t = theme();
+  largeTitle(b, "Notes", 16, k_top + 6);
+  char count[24];
+  fmt(count, sizeof(count), "%d note%s", s.notes.count, s.notes.count > 1 ? "s" : "");
+  text(b, count, 304, k_top + 12, t.secondary, Small, Align::Right);
+  int y = 54;
+  for (int i = -1; i < s.notes.count; i++) {
+    Rect r = {12, y, 296, i < 0 ? 28 : 38};
+    bool sel = s.notes.selected == i;
+    roundFill(b, r, 10, sel ? t.highlight : t.card);
+    if (i < 0) {
+      tinted(b, IOSIcons::IconPlus, r.x + 10, r.y + 8, t.yellow);
+      text(b, "Nouvelle note", r.x + 30, r.y + 7, rgb(0xE0A800), Small);
+    } else {
+      char line0[48], line1[48];
+      noteTitle(s.notes.text[i], line0, sizeof(line0), 0);
+      noteTitle(s.notes.text[i], line1, sizeof(line1), 1);
+      text(b, line0[0] ? line0 : "Nouvelle note", r.x + 12, r.y + 4, t.text,
+           Small, Align::Left, 270);
+      text(b, line1[0] ? line1 : "Aucun texte supplementaire", r.x + 12,
+           r.y + 20, t.secondary, Small, Align::Left, 270);
+    }
+    y += r.h + 6;
+  }
+  text(b, "OK : ouvrir   <x : supprimer", 160, 224, t.secondary, Small,
+       Align::Center);
+}
+
+void drawNoteEditor(Band& b) {
+  const Theme& t = theme();
+  text(b, "< Notes", 12, k_top + 2, rgb(0xE0A800), Small);
+  text(b, "OK", 306, k_top + 2, rgb(0xE0A800), Small, Align::Right);
+  const char* p = s.notes.text[s.notes.selected];
+  int gw = glyphWidth(Small);
+  int perLine = 296 / gw;
+  int x = 12, y = k_top + 24, col = 0;
+  char line[48];
+  int n = 0;
+  bool first = true;
+  auto flush = [&]() {
+    line[n] = 0;
+    if (first) {
+      scaledText(b, line, x, y - 2, t.text, 72);
+      y += 22;
+      first = false;
+    } else {
+      text(b, line, x, y, t.text, Small);
+      y += 16;
+    }
+    n = 0;
+    col = 0;
+  };
+  for (; *p; p++) {
+    if (*p == '\n') {
+      flush();
+      continue;
+    }
+    if (col >= perLine - (first ? 10 : 0) || n >= 46) {
+      flush();
+    }
+    line[n++] = *p;
+    col++;
+  }
+  // The cursor blinks at the end
+  line[n] = 0;
+  int cursorX = x + (first ? scaledTextWidth(line, 72) : textWidth(line));
+  int cursorY = y;
+  flush();
+  if ((now() / 500) % 2 == 0) {
+    fill(b, {cursorX + 1, cursorY - (first ? 0 : 0), 2, first ? 18 : 14}, rgb(0xE0A800));
+  }
+  char info[32];
+  fmt(info, sizeof(info), "%d / %d", static_cast<int>(strlen(s.notes.text[s.notes.selected])),
+      NotesState::k_length);
+  text(b, info, 306, 224, t.secondary, Small, Align::Right);
+  text(b, "EXE : a la ligne", 12, 224, t.secondary, Small);
+}
+
+void notesRender(Band& b) {
+  background(b);
+  if (s.notes.editing) {
+    drawNoteEditor(b);
+  } else {
+    drawNoteList(b);
+  }
+}
+
+void deleteNote(int i) {
+  for (int j = i; j + 1 < s.notes.count; j++) {
+    memcpy(s.notes.text[j], s.notes.text[j + 1], sizeof(s.notes.text[j]));
+  }
+  s.notes.count--;
+  if (s.notes.selected >= s.notes.count) {
+    s.notes.selected = static_cast<int8_t>(s.notes.count - 1);
+  }
+}
+
+bool notesHandle(Event e) {
+  NotesState& n = s.notes;
+  if (n.editing) {
+    char* text_ = n.text[n.selected];
+    int len = strlen(text_);
+    if (e == Events::Back || e == Events::OK) {
+      n.editing = false;
+      setAlphaLock(false);
+      if (len == 0) {
+        deleteNote(n.selected);
+      }
+    } else if (e == Events::Backspace) {
+      if (len > 0) {
+        text_[len - 1] = 0;
+      }
+    } else if (e == Events::EXE) {
+      if (len < NotesState::k_length) {
+        text_[len] = '\n';
+        text_[len + 1] = 0;
+      }
+    } else {
+      const char* t = e.text();
+      if (t && t[0] >= ' ' && static_cast<uint8_t>(t[0]) < 127 && t[1] == 0 &&
+          len < NotesState::k_length) {
+        text_[len] = t[0];
+        text_[len + 1] = 0;
+      } else if (!e.isKeyboardEvent()) {
+        return false;
+      }
+    }
+    invalidateAll();
+    return true;
+  }
+  if (e == Events::Up && n.selected > -1) {
+    n.selected--;
+  } else if (e == Events::Down && n.selected < n.count - 1) {
+    n.selected++;
+  } else if (e == Events::OK || e == Events::EXE) {
+    if (n.selected < 0) {
+      if (n.count >= NotesState::k_notes) {
+        showBanner("Notes", "6 notes au maximum", IOSIcons::IconPlus, rgb(0xFFCC00));
+        return true;
+      }
+      // New notes go first
+      for (int j = n.count; j > 0; j--) {
+        memcpy(n.text[j], n.text[j - 1], sizeof(n.text[j]));
+      }
+      n.text[0][0] = 0;
+      n.count++;
+      n.selected = 0;
+    }
+    n.editing = true;
+    setAlphaLock(true);
+  } else if (e == Events::Backspace && n.selected >= 0) {
+    deleteNote(n.selected);
+  } else {
+    return false;
+  }
+  invalidateAll();
+  return true;
+}
+
+/* ============================================================== Games */
+
+void gamesRender(Band& b) {
+  background(b);
+  const Theme& t = theme();
+  largeTitle(b, "Jeux", 16, k_top + 6);
+  // The featured card
+  Rect hero = {12, 50, 296, 62};
+  // A proper gradient, row by row inside the rounded card
+  {
+    Rect z = hero.intersection(b.clip());
+    for (int y = z.y; y < z.bottom(); y++) {
+      Rect old = b.clip();
+      if (b.setClip(Rect{hero.x, y, hero.w, 1}.intersection(old))) {
+        roundFill(b, hero, 14, mix(0xFF2D55, 0x5E5CE6, (y - hero.y) * 256 / hero.h));
+      }
+      b.setClip(old);
+    }
+  }
+  text(b, "A LA UNE", hero.x + 14, hero.y + 8, rgb(0xFFE0E8), Small);
+  text(b, "Tes jeux .nwa", hero.x + 14, hero.y + 24, rgb(0xFFFFFF), Large);
+  image(b, IOSIcons::IconGames, hero.right() - 50, hero.y + 13, 36);
+  int n = numberOfGames();
+  if (n == 0) {
+    text(b, "Aucun jeu installe", 160, 140, t.text, Large, Align::Center);
+    text(b, "Ajoute des .nwa avec l'installateur", 160, 166, t.secondary,
+         Small, Align::Center);
+    return;
+  }
+  int first = s.gamesSelected > 2 ? s.gamesSelected - 2 : 0;
+  for (int i = first; i < n && i < first + 3; i++) {
+    int y = 120 + (i - first) * 38;
+    Rect r = {12, y, 296, 34};
+    bool sel = i == s.gamesSelected;
+    roundFill(b, r, 10, sel ? t.highlight : t.card);
+    drawSlotIcon(b, {Slot::Kind::External, static_cast<int8_t>(i)}, r.x + 6,
+                 r.y + 3, 28);
+    text(b, gameName(i), r.x + 42, r.y + 3, t.text, Small, Align::Left, 170);
+    text(b, "Jeu NumWorks", r.x + 42, r.y + 18, t.secondary, Small);
+    Rect pill = {r.right() - 70, r.y + 7, 60, 20};
+    roundFill(b, pill, 10, sel ? t.accent : (t.dark ? rgb(0x2C2C2E) : rgb(0xEEEEF3)));
+    text(b, "OUVRIR", pill.x + pill.w / 2, pill.y + 3, sel ? rgb(0xFFFFFF) : t.accent,
+         Small, Align::Center);
+  }
+}
+
+bool gamesHandle(Event e) {
+  int n = numberOfGames();
+  if (e == Events::Up && s.gamesSelected > 0) {
+    s.gamesSelected--;
+  } else if (e == Events::Down && s.gamesSelected < n - 1) {
+    s.gamesSelected++;
+  } else if ((e == Events::OK || e == Events::EXE) && n > 0) {
+    launchSlot({Slot::Kind::External, s.gamesSelected});
+    return true;
+  } else {
+    return false;
+  }
+  invalidateAll();
+  return true;
+}
