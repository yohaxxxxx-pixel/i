+/* The NumWorks font has no accented letters: French text is written without
+ * accents (é -> e, « » -> "), the way it is typed on the calculator. */
+void plainText(const char* in, char* out, int size) {
+  int n = 0;
+  while (*in && n < size - 1) {
+    uint8_t c = static_cast<uint8_t>(*in);
+    if (c == 0xC3 && in[1]) {
+      uint8_t d = static_cast<uint8_t>(in[1]);
+      const char* map =
+          "AAAAAAACEEEEIIII"  // C3 80..8F
+          "DNOOOOO*OUUUUYTs"  // C3 90..9F
+          "aaaaaaaceeeeiiii"  // C3 A0..AF
+          "dnooooo/ouuuuyty";  // C3 B0..BF
+      if (d >= 0x80 && d <= 0xBF) {
+        char r = map[d - 0x80];
+        if (d == 0x97) {
+          // × exists in the font: keep it
+          if (n + 2 < size) {
+            out[n++] = *in;
+            out[n++] = in[1];
+          }
+        } else {
+          out[n++] = r;
+        }
+        in += 2;
+        continue;
+      }
+    }
+    if (c == 0xC2 && (static_cast<uint8_t>(in[1]) == 0xAB ||
+                      static_cast<uint8_t>(in[1]) == 0xBB)) {
+      out[n++] = '"';
+      in += 2;
+      continue;
+    }
+    if (c == 0xC2 && static_cast<uint8_t>(in[1]) == 0xA0) {
+      out[n++] = ' ';
+      in += 2;
+      continue;
+    }
+    if (c == 0xC5 && (static_cast<uint8_t>(in[1]) == 0x93 ||
+                      static_cast<uint8_t>(in[1]) == 0x92)) {
+      // œ
+      out[n++] = static_cast<uint8_t>(in[1]) == 0x93 ? 'o' : 'O';
+      if (n < size - 1) {
+        out[n++] = static_cast<uint8_t>(in[1]) == 0x93 ? 'e' : 'E';
+      }
+      in += 2;
+      continue;
+    }
+    if (c == 0xE2 && static_cast<uint8_t>(in[1]) == 0x80) {
+      uint8_t d = static_cast<uint8_t>(in[2]);
+      // ’ ‘ -> ', “ ” -> ", … -> ..., – — -> -
+      char r = (d == 0x98 || d == 0x99) ? '\''
+               : (d == 0x9C || d == 0x9D) ? '"'
+               : (d == 0x93 || d == 0x94) ? '-'
+                                          : 0;
+      if (d == 0xA6) {
+        for (int k = 0; k < 3 && n < size - 1; k++) {
+          out[n++] = '.';
+        }
+        in += 3;
+        continue;
+      }
+      if (r) {
+        out[n++] = r;
+        in += 3;
+        continue;
+      }
+    }
+    out[n++] = *in++;
+  }
+  out[n] = 0;
+}
+
+int glyphWidth(KDFont::Size font) { return KDFont::GlyphMaxWidth(font); }
+int glyphHeight(KDFont::Size font) { return KDFont::GlyphHeight(font); }
+
+int textWidth(const char* s, KDFont::Size font) {
+  char plain[128];
+  plainText(s, plain, sizeof(plain));
+  return KDFont::Font(font)->stringSize(plain).width();
+}
+
+void text(Band& b, const char* s, int x, int y, KDColor c, KDFont::Size font,
+          Align align, int maxWidth) {
+  if (s == nullptr || s[0] == 0) {
+    return;
+  }
+  char plain[128];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  int h = glyphHeight(font);
+  if (y >= b.clip().bottom() || y + h <= b.clip().y) {
+    return;
+  }
+  // Cut the text so that it fits in maxWidth (and in the buffer)
+  constexpr int k_maxChars = 48;
+  char buffer[k_maxChars + 4];
+  int gw = glyphWidth(font);
+  int limit = (maxWidth < k_textBufferWidth ? maxWidth : k_textBufferWidth) / gw;
+  int len = strlen(s);
+  if (limit <= 0) {
+    return;
+  }
+  if (len > limit || len > k_maxChars) {
+    int keep = (limit < k_maxChars ? limit : k_maxChars) - 1;
+    if (keep < 1) {
+      keep = 1;
+    }
+    // Do not cut a UTF-8 sequence in the middle
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    // Cut like the reference ("Calcul", "Equati"), with no ellipsis
+    keep++;
+    while (keep > 0 && (static_cast<uint8_t>(s[keep]) & 0xC0) == 0x80) {
+      keep--;
+    }
+    memcpy(buffer, s, keep);
+    buffer[keep] = 0;
+    s = buffer;
+  }
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  if (align == Align::Center) {
+    x -= w / 2;
+  } else if (align == Align::Right) {
+    x -= w;
+  }
+  Rect z = Rect{x, y, w, h}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite,
+                  .backgroundColor = KDBlack,
+                  .font = font});
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src = s_textBuffer + (yy - y) * k_textBufferWidth - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = src[xx].green();
+      if (a) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+
+void bigText(Band& b, const char* s, int x, int y, KDColor c, int scale,
+             Align align) {
+  KDFont::Size font = KDFont::Size::Large;
+  char plain[64];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  int h = size.height() < k_textBufferHeight ? size.height() : k_textBufferHeight;
+  if (align == Align::Center) {
+    x -= w * scale / 2;
+  } else if (align == Align::Right) {
+    x -= w * scale;
+  }
+  Rect z = Rect{x, y, w * scale, h * scale}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite, .backgroundColor = KDBlack, .font = font});
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    // Bilinear sampling of the coverage, for smooth big digits
+    int fy = ((yy - y) * 256 + 128) / scale - 128;
+    int y0 = fy >> 8, ty = fy & 255;
+    if (fy < 0) {
+      y0 = 0;
+      ty = 0;
+    }
+    int y1 = y0 + 1 < h ? y0 + 1 : y0;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int fx = ((xx - x) * 256 + 128) / scale - 128;
+      int x0 = fx >> 8, tx = fx & 255;
+      if (fx < 0) {
+        x0 = 0;
+        tx = 0;
+      }
+      int x1 = x0 + 1 < w ? x0 + 1 : x0;
+      int a00 = s_textBuffer[y0 * k_textBufferWidth + x0].green();
+      int a10 = s_textBuffer[y0 * k_textBufferWidth + x1].green();
+      int a01 = s_textBuffer[y1 * k_textBufferWidth + x0].green();
+      int a11 = s_textBuffer[y1 * k_textBufferWidth + x1].green();
+      int top = a00 + (a10 - a00) * tx / 256;
+      int bottom = a01 + (a11 - a01) * tx / 256;
+      int a = top + (bottom - top) * ty / 256;
+      // Sharpen the edges a little
+      a = (a - 64) * 2;
+      if (a > 0) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+
+/* ------------------------------------------------------------ scaled text */
+
+int scaledTextWidth(const char* s, int scale64) {
+  return textWidth(s, KDFont::Size::Large) * scale64 / 64;
+}
+
+void scaledText(Band& b, const char* s, int x, int y, KDColor c, int scale64,
+                Align align) {
+  if (scale64 <= 0 || s == nullptr || s[0] == 0) {
+    return;
+  }
+  KDFont::Size font = KDFont::Size::Large;
+  char plain[64];
+  plainText(s, plain, sizeof(plain));
+  s = plain;
+  KDSize size = KDFont::Font(font)->stringSize(s);
+  int w = size.width() < k_textBufferWidth ? size.width() : k_textBufferWidth;
+  int h = size.height() < k_textBufferHeight ? size.height() : k_textBufferHeight;
+  int dw = w * scale64 / 64, dh = h * scale64 / 64;
+  if (align == Align::Center) {
+    x -= dw / 2;
+  } else if (align == Align::Right) {
+    x -= dw;
+  }
+  Rect z = Rect{x, y, dw, dh}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  TextContext ctx;
+  ctx.fillRect(KDRect(0, 0, w, h), KDBlack);
+  ctx.drawString(s, KDPointZero,
+                 {.glyphColor = KDWhite, .backgroundColor = KDBlack, .font = font});
+  bool sharpen = scale64 > 96;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    int fy = ((yy - y) * 64 * 256 + 32 * 256) / scale64 - 128;
+    if (fy < 0) {
+      fy = 0;
+    }
+    int y0 = fy >> 8, ty = fy & 255;
+    if (y0 >= h) {
+      continue;
+    }
+    int y1 = y0 + 1 < h ? y0 + 1 : y0;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int fx = ((xx - x) * 64 * 256 + 32 * 256) / scale64 - 128;
+      if (fx < 0) {
+        fx = 0;
+      }
+      int x0 = fx >> 8, tx = fx & 255;
+      if (x0 >= w) {
+        continue;
+      }
+      int x1 = x0 + 1 < w ? x0 + 1 : x0;
+      int a00 = s_textBuffer[y0 * k_textBufferWidth + x0].green();
+      int a10 = s_textBuffer[y0 * k_textBufferWidth + x1].green();
+      int a01 = s_textBuffer[y1 * k_textBufferWidth + x0].green();
+      int a11 = s_textBuffer[y1 * k_textBufferWidth + x1].green();
+      int top = a00 + (a10 - a00) * tx / 256;
+      int bottom = a01 + (a11 - a01) * tx / 256;
+      int a = top + (bottom - top) * ty / 256;
+      if (sharpen) {
+        a = (a - 70) * 2;
+      }
+      if (a > 0) {
+        blendPixel(row + xx, c, a >= 252 ? 256 : a);
+      }
+    }
+  }
+}
+
+/* ------------------------------------------------------- lines and rings */
+
+static inline float clampf(float v, float lo, float hi) {
+  return v < lo ? lo : (v > hi ? hi : v);
+}
+
+void line(Band& b, float x0, float y0, float x1, float y1, float width,
+          KDColor c, int alpha) {
+  float hw = width / 2.f;
+  int minX = static_cast<int>(floorf((x0 < x1 ? x0 : x1) - hw - 1));
+  int maxX = static_cast<int>(ceilf((x0 > x1 ? x0 : x1) + hw + 1));
+  int minY = static_cast<int>(floorf((y0 < y1 ? y0 : y1) - hw - 1));
+  int maxY = static_cast<int>(ceilf((y0 > y1 ? y0 : y1) + hw + 1));
+  Rect z = Rect{minX, minY, maxX - minX, maxY - minY}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  float dx = x1 - x0, dy = y1 - y0;
+  float len2 = dx * dx + dy * dy;
+  float inv = len2 > 0.0001f ? 1.f / len2 : 0.f;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    float py = yy + 0.5f;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      float px = xx + 0.5f;
+      float t = clampf(((px - x0) * dx + (py - y0) * dy) * inv, 0.f, 1.f);
+      float ex = px - (x0 + t * dx), ey = py - (y0 + t * dy);
+      float d = sqrtf(ex * ex + ey * ey);
+      float cov = clampf(hw + 0.5f - d, 0.f, 1.f);
+      if (cov > 0.f) {
+        blendPixel(row + xx, c, static_cast<int>(cov * alpha));
+      }
+    }
+  }
+}
+
+void ring(Band& b, float cx, float cy, float r, float width, float fraction,
+          KDColor c, int alpha) {
+  if (fraction <= 0.f) {
+    return;
+  }
+  float hw = width / 2.f;
+  int ext = static_cast<int>(r + hw + 2);
+  Rect z = Rect{static_cast<int>(cx) - ext, static_cast<int>(cy) - ext,
+                2 * ext, 2 * ext}
+               .intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  bool full = fraction >= 1.f;
+  float endAngle = fraction * 2.f * static_cast<float>(M_PI);
+  float ex = cx + r * sinf(endAngle), ey = cy - r * cosf(endAngle);
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    float py = yy + 0.5f - cy;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      float px = xx + 0.5f - cx;
+      float d = sqrtf(px * px + py * py);
+      float cov = clampf(hw + 0.5f - fabsf(d - r), 0.f, 1.f);
+      if (cov <= 0.f) {
+        continue;
+      }
+      if (!full) {
+        float a = atan2f(px, -py);
+        if (a < 0.f) {
+          a += 2.f * static_cast<float>(M_PI);
+        }
+        if (a > endAngle) {
+          // Round caps at both ends
+          float sx = px, sy = py + r;
+          float qx = xx + 0.5f - ex, qy = yy + 0.5f - ey;
+          float dc = sqrtf(sx * sx + sy * sy);
+          float de = sqrtf(qx * qx + qy * qy);
+          float m = dc < de ? dc : de;
+          cov = clampf(hw + 0.5f - m, 0.f, 1.f);
+          if (cov <= 0.f) {
+            continue;
+          }
+        }
+      }
+      blendPixel(row + xx, c, static_cast<int>(cov * alpha));
+    }
+  }
+}
+
+void warmFilter(Band& b, int strength) {
+  const Rect& z = b.clip();
+  int gk = 1024 - strength;      // green down to 75 %
+  int bk = 512 - strength;       // blue down to 50 %
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      uint16_t v = static_cast<uint16_t>(row[x]);
+      int g = (v >> 5) & 63, bl = v & 31;
+      g = g * gk / 1024;
+      bl = bl * bk / 512;
+      row[x] = KDColor::RGB16((v & 0xF800) | (g << 5) | bl);
+    }
+  }
+}
+
+/* ------------------------------------------------------------- wallpaper */
+
+namespace {
+
+constexpr int k_wallW = 81, k_wallH = 61;  // one point every 4 pixels
+uint16_t s_wall[k_wallW * k_wallH];
+constexpr int k_blurW = 40, k_blurH = 30;  // one point every 8 pixels
+uint16_t s_capture[k_blurW * k_blurH];
+
+constexpr uint8_t k_bayer[16] = {0, 8, 2, 10, 12, 4, 14, 6,
+                                 3, 11, 1, 9, 15, 7, 13, 5};
+
+inline void unpack(uint16_t c, int& r, int& g, int& b) {
+  r = (c >> 11) & 31;
+  r = (r << 3) | (r >> 2);
+  g = (c >> 5) & 63;
+  g = (g << 2) | (g >> 4);
+  b = c & 31;
+  b = (b << 3) | (b >> 2);
+}
+
+inline uint16_t pack(float r, float g, float b) {
+  int ri = static_cast<int>(clampf(r, 0.f, 1.f) * 255.f + 0.5f);
+  int gi = static_cast<int>(clampf(g, 0.f, 1.f) * 255.f + 0.5f);
+  int bi = static_cast<int>(clampf(b, 0.f, 1.f) * 255.f + 0.5f);
+  return static_cast<uint16_t>(((ri >> 3) << 11) | ((gi >> 2) << 5) | (bi >> 3));
+}
+
+struct Col {
+  float r, g, b;
+};
+
+Col hex(uint32_t v) {
+  return {((v >> 16) & 255) / 255.f, ((v >> 8) & 255) / 255.f,
+          (v & 255) / 255.f};
+}
+
+Col mixc(Col a, Col b, float t) {
+  return {a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t};
+}
+
+Col addGlow(Col c, Col glow, float k) {
+  return {c.r + glow.r * k, c.g + glow.g * k, c.b + glow.b * k};
+}
+
+// Piecewise gradient through n colours, t in [0, 1]
+Col ramp(const uint32_t* stops, int n, float t) {
+  t = clampf(t, 0.f, 0.9999f) * (n - 1);
+  int i = static_cast<int>(t);
+  return mixc(hex(stops[i]), hex(stops[i + 1]), t - i);
+}
+
+float blob(float u, float v, float cu, float cv, float k) {
+  float du = u - cu, dv = v - cv;
+  return expf(-(du * du * 1.78f + dv * dv) * k);
+}
+
+
+Col wallpaperCol(int index, float u, float v) {
+  switch (index) {
+    default:
+    case 0: {
+      // "Aurore": layered colour waves
+      constexpr uint32_t k_stops[] = {0x16246B, 0x4B2BC9, 0xA23BD8, 0xF0569B,
+                                      0xFF8A3D, 0xFFC93C, 0x35C76E, 0x1A8FE0};
+      float w = v * 0.9f + 0.16f * sinf(u * 5.2f + 0.8f) +
+                0.07f * sinf(u * 11.f - v * 4.f) + 0.05f;
+      Col c = ramp(k_stops, 8, w);
+      // Soft ridges between the waves (no hard edge: the wallpaper is
+      // computed at a quarter of the resolution)
+      float s = 0.5f + 0.5f * sinf(w * 31.4f);
+      float shade = 0.84f + 0.16f * s * s;
+      c = {c.r * shade, c.g * shade, c.b * shade};
+      return addGlow(c, hex(0xFFFFFF), 0.18f * blob(u, v, 0.72f, 0.28f, 7.f));
+    }
+    case 1: {
+      // "Ocean": deep blue with luminous blobs
+      Col c = mixc(hex(0x061A40), hex(0x0B6E8E), v * 0.8f + u * 0.2f);
+      c = addGlow(c, hex(0x2EE6D6), 0.55f * blob(u, v, 0.18f, 0.25f, 6.f));
+      c = addGlow(c, hex(0x3B5BFF), 0.6f * blob(u, v, 0.85f, 0.75f, 5.f));
+      c = addGlow(c, hex(0x9B5CFF), 0.45f * blob(u, v, 0.72f, 0.12f, 9.f));
+      return c;
+    }
+    case 2: {
+      // "Crepuscule": sunset over hills
+      constexpr uint32_t k_sky[] = {0x1B1446, 0x6B2A7A, 0xE0565B, 0xFFB347};
+      Col c = ramp(k_sky, 4, v * 1.15f);
+      c = addGlow(c, hex(0xFFE29A), 0.7f * blob(u, v, 0.62f, 0.72f, 18.f));
+      float hill1 = 0.70f + 0.06f * sinf(u * 6.f + 1.f);
+      float hill2 = 0.82f + 0.05f * sinf(u * 9.f + 3.f);
+      c = mixc(c, hex(0x3A1752), 0.75f * clampf((v - hill1) / 0.04f + 0.5f, 0.f, 1.f));
+      c = mixc(c, hex(0x1A0B2E), 0.85f * clampf((v - hill2) / 0.04f + 0.5f, 0.f, 1.f));
+      return c;
+    }
+    case 3: {
+      // "Graphite": dark and soft
+      Col c = mixc(hex(0x1C1C22), hex(0x2B2B48), v);
+      c = addGlow(c, hex(0x6E56CF), 0.45f * blob(u, v, 0.3f, 0.7f, 5.f));
+      c = addGlow(c, hex(0x2F80ED), 0.35f * blob(u, v, 0.8f, 0.3f, 6.f));
+      return c;
+    }
+  }
+}
+
+void boxBlur(uint16_t* grid, int w, int h) {
+  uint16_t tmp[k_blurW * k_blurH];  // on the stack: static RAM is scarce
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      int sr = 0, sg = 0, sb = 0, n = 0;
+      for (int j = -1; j <= 1; j++) {
+        for (int i = -1; i <= 1; i++) {
+          int xx = x + i, yy = y + j;
+          if (xx < 0 || yy < 0 || xx >= w || yy >= h) {
+            continue;
+          }
+          int r, g, b;
+          unpack(grid[yy * w + xx], r, g, b);
+          sr += r;
+          sg += g;
+          sb += b;
+          n++;
+        }
+      }
+      tmp[y * w + x] = pack(sr / (255.f * n), sg / (255.f * n), sb / (255.f * n));
+    }
+  }
+  memcpy(grid, tmp, sizeof(uint16_t) * w * h);
+}
+
+// Bilinear sample of a grid whose point (i, j) is at pixel (i * cell + o)
+inline KDColor sampleGrid(const uint16_t* g, int gw, int gh, int cell, int o,
+                          int x, int y) {
+  int fx = ((x - o) * 256) / cell;
+  int fy = ((y - o) * 256) / cell;
+  int maxX = (gw - 1) * 256, maxY = (gh - 1) * 256;
+  fx = fx < 0 ? 0 : (fx > maxX ? maxX : fx);
+  fy = fy < 0 ? 0 : (fy > maxY ? maxY : fy);
+  int ix = fx >> 8, tx = fx & 255, iy = fy >> 8, ty = fy & 255;
+  int ix1 = ix + 1 < gw ? ix + 1 : ix, iy1 = iy + 1 < gh ? iy + 1 : iy;
+  int r0, g0, b0, r1, g1, b1, r2, g2, b2, r3, g3, b3;
+  unpack(g[iy * gw + ix], r0, g0, b0);
+  unpack(g[iy * gw + ix1], r1, g1, b1);
+  unpack(g[iy1 * gw + ix], r2, g2, b2);
+  unpack(g[iy1 * gw + ix1], r3, g3, b3);
+  int rt = r0 + (r1 - r0) * tx / 256, rb = r2 + (r3 - r2) * tx / 256;
+  int gt = g0 + (g1 - g0) * tx / 256, gb = g2 + (g3 - g2) * tx / 256;
+  int bt = b0 + (b1 - b0) * tx / 256, bb = b2 + (b3 - b2) * tx / 256;
+  return KDColor::RGB888(static_cast<uint8_t>(rt + (rb - rt) * ty / 256),
+                         static_cast<uint8_t>(gt + (gb - gt) * ty / 256),
+                         static_cast<uint8_t>(bt + (bb - bt) * ty / 256));
+}
+
+}  // namespace
+
+KDColor wallpaperColor(int index, float u, float v) {
+  Col c = wallpaperCol(index, u, v);
+  return KDColor::RGB16(pack(c.r, c.g, c.b));
+}
+
+void prepareWallpaper(int index, bool dark) {
+  float k = dark ? 0.62f : 1.f;
+  for (int j = 0; j < k_wallH; j++) {
+    for (int i = 0; i < k_wallW; i++) {
+      Col c = wallpaperCol(index, i / (k_wallW - 1.f), j / (k_wallH - 1.f));
+      s_wall[j * k_wallW + i] = pack(c.r * k, c.g * k, c.b * k);
+    }
+  }
+}
+
+void wallpaper(Band& b, int dx, int dy) {
+  const Rect& z = b.clip();
+  if (z.isEmpty()) {
+    return;
+  }
+  // Vertical interpolation once per row, then horizontal, in 8.8 fixed point
+  int32_t lr[k_wallW], lg[k_wallW], lb[k_wallW];
+  int ix0 = z.x + dx, ix1 = z.right() - 1 + dx;
+  ix0 = ix0 < 0 ? 0 : (ix0 > 319 ? 319 : ix0);
+  ix1 = ix1 < 0 ? 0 : (ix1 > 319 ? 319 : ix1);
+  ix0 >>= 2;
+  ix1 = (ix1 >> 2) + 1;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    int wy = y + dy;
+    wy = wy < 0 ? 0 : (wy > 239 ? 239 : wy);
+    int iy = wy >> 2, ty = wy & 3;
+    const uint16_t* r0 = s_wall + iy * k_wallW;
+    const uint16_t* r1 = r0 + k_wallW;
+    for (int i = ix0; i <= ix1; i++) {
+      int ra, ga, ba, rc, gc, bc;
+      unpack(r0[i], ra, ga, ba);
+      unpack(r1[i], rc, gc, bc);
+      lr[i] = (ra * (4 - ty) + rc * ty) << 6;
+      lg[i] = (ga * (4 - ty) + gc * ty) << 6;
+      lb[i] = (ba * (4 - ty) + bc * ty) << 6;
+    }
+    const uint8_t* bayer = k_bayer + (y & 3) * 4;
+    for (int x = z.x; x < z.right(); x++) {
+      int wx = x + dx;
+      wx = wx < 0 ? 0 : (wx > 319 ? 319 : wx);
+      int ix = wx >> 2, tx = wx & 3;
+      int r16 = lr[ix] + (((lr[ix + 1] - lr[ix]) * tx) >> 2);
+      int g16 = lg[ix] + (((lg[ix + 1] - lg[ix]) * tx) >> 2);
+      int b16 = lb[ix] + (((lb[ix + 1] - lb[ix]) * tx) >> 2);
+      int d = bayer[x & 3] << 12;
+      int r5 = (r16 * 31 + d) >> 16;
+      int g6 = (g16 * 63 + d) >> 16;
+      int b5 = (b16 * 31 + d) >> 16;
+      row[x] = KDColor::RGB16(static_cast<uint16_t>((r5 << 11) | (g6 << 5) | b5));
+    }
+  }
+}
+
+/* ---------------------------------------------------------- liquid glass */
+
+namespace {
+
+// RGB565 blend, alpha in 0..32
+inline uint16_t blend565(uint16_t fg, uint16_t bg, uint32_t a) {
+  uint32_t f = (fg | (static_cast<uint32_t>(fg) << 16)) & 0x07E0F81F;
+  uint32_t k = (bg | (static_cast<uint32_t>(bg) << 16)) & 0x07E0F81F;
+  uint32_t r = ((f * a + k * (32 - a)) >> 5) & 0x07E0F81F;
+  return static_cast<uint16_t>(r | (r >> 16));
+}
+
+// The capture is kept darkened: it is the background of the control center
+constexpr int k_captureDim = 110;
+
+}  // namespace
+
+KDColor blurredWallpaper(int x, int y) {
+  /* The wallpaper is already smooth: its low resolution grid, without the
+   * dithering, is what the glass sees */
+  return sampleGrid(s_wall, k_wallW, k_wallH, 4, 0, x, y);
+}
+
+KDColor blurredCapture(int x, int y) {
+  return sampleGrid(s_capture, k_blurW, k_blurH, 8, 4, x, y);
+}
+
+void capture(void (*render)(Band&)) {
+  Band band;
+  constexpr float k_keep = (256 - k_captureDim) / 256.f / (64 * 255.f);
+  for (int j = 0; j < k_blurH; j++) {
+    band.begin({0, j * 8, k_screenWidth, 8});
+    render(band);
+    for (int i = 0; i < k_blurW; i++) {
+      int sr = 0, sg = 0, sb = 0;
+      for (int yy = 0; yy < 8; yy++) {
+        const KDColor* row = band.row(j * 8 + yy);
+        for (int xx = 0; xx < 8; xx++) {
+          KDColor c = row[i * 8 + xx];
+          sr += c.red();
+          sg += c.green();
+          sb += c.blue();
+        }
+      }
+      s_capture[j * k_blurW + i] = pack(sr * k_keep, sg * k_keep, sb * k_keep);
+    }
+  }
+  boxBlur(s_capture, k_blurW, k_blurH);
+  boxBlur(s_capture, k_blurW, k_blurH);
+}
+
+void captureBackground(Band& b, int dimAlpha, int alpha) {
+  (void)dimAlpha;  // the capture is stored darkened already
+  const Rect& z = b.clip();
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  uint32_t a32 = alpha >= 256 ? 32 : static_cast<uint32_t>(alpha) >> 3;
+  int vr[k_blurW], vg[k_blurW], vb[k_blurW];
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    int fy = y - 4;
+    fy = fy < 0 ? 0 : (fy > (k_blurH - 1) * 8 ? (k_blurH - 1) * 8 : fy);
+    int iy = fy >> 3, ty = fy & 7;
+    int iy1 = iy + 1 < k_blurH ? iy + 1 : iy;
+    for (int i = 0; i < k_blurW; i++) {
+      int r0, g0, b0, r1, g1, b1;
+      unpack(s_capture[iy * k_blurW + i], r0, g0, b0);
+      unpack(s_capture[iy1 * k_blurW + i], r1, g1, b1);
+      vr[i] = r0 * (8 - ty) + r1 * ty;
+      vg[i] = g0 * (8 - ty) + g1 * ty;
+      vb[i] = b0 * (8 - ty) + b1 * ty;
+    }
+    for (int x = z.x; x < z.right(); x++) {
+      int fx = x - 4;
+      fx = fx < 0 ? 0 : (fx > (k_blurW - 1) * 8 ? (k_blurW - 1) * 8 : fx);
+      int i = fx >> 3, t = fx & 7;
+      int i1 = i + 1 < k_blurW ? i + 1 : i;
+      int r = (vr[i] * (8 - t) + vr[i1] * t) >> 6;
+      int g = (vg[i] * (8 - t) + vg[i1] * t) >> 6;
+      int bl = (vb[i] * (8 - t) + vb[i1] * t) >> 6;
+      uint16_t c = static_cast<uint16_t>(((r >> 3) << 11) | ((g >> 2) << 5) | (bl >> 3));
+      uint16_t* p = reinterpret_cast<uint16_t*>(row + x);
+      *p = a32 >= 32 ? c : blend565(c, *p, a32);
+    }
+  }
+}
+
+void glass(Band& b, Rect r, int radius, Backdrop backdrop, const Glass& g) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || g.alpha <= 0) {
+    return;
+  }
+  float hw = r.w / 2.f, hh = r.h / 2.f;
+  float cx = r.x + hw, cy = r.y + hh;
+  float rad = static_cast<float>(radius);
+  float ix = hw - rad, iy = hh - rad;
+  int bevelI = radius < 10 ? (radius > 4 ? radius : 4) : 10;
+  float bevel = static_cast<float>(bevelI);
+  constexpr float k_lx = -0.6f, k_ly = -0.8f;  // light from the top left
+  uint16_t tint565 = static_cast<uint16_t>(g.tint);
+  uint32_t tint32 = static_cast<uint32_t>(g.tintAlpha) >> 3;
+  uint32_t fade32 = g.alpha >= 256 ? 32 : static_cast<uint32_t>(g.alpha) >> 3;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    uint16_t* row16 = reinterpret_cast<uint16_t*>(row);
+    float py = y + 0.5f - cy;
+    float ay = fabsf(py);
+    float sy = py < 0 ? -1.f : 1.f;
+    // Gloss: the top of the glass catches more light
+    float gloss = 1.f - (y - r.y) / (r.h * 0.55f);
+    int glossAlpha = gloss > 0 ? static_cast<int>(gloss * gloss * 34) : 0;
+    uint32_t gloss32 = static_cast<uint32_t>(glossAlpha) >> 3;
+    /* Fast span: far enough from every edge, the glass only frosts what is
+     * already below it (no refraction, no rim) */
+    int edgeY = y - r.y < r.bottom() - 1 - y ? y - r.y : r.bottom() - 1 - y;
+    int inner = edgeY >= radius ? bevelI : (edgeY >= bevelI ? radius : 100000);
+    int fx0 = r.x + inner, fx1 = r.right() - inner;
+    for (int x = z.x; x < z.right(); x++) {
+      if (x >= fx0 && x < fx1) {
+        uint16_t under = row16[x];
+        uint16_t c = blend565(tint565, under, tint32);
+        if (gloss32) {
+          c = blend565(0xFFFF, c, gloss32);
+        }
+        row16[x] = fade32 >= 32 ? c : blend565(c, under, fade32);
+        continue;
+      }
+      float px = x + 0.5f - cx;
+      float ax = fabsf(px);
+      float sx = px < 0 ? -1.f : 1.f;
+      float qx = ax - ix, qy = ay - iy;
+      float dist, nx, ny;
+      if (qx > 0.f && qy > 0.f) {
+        float l = sqrtf(qx * qx + qy * qy);
+        dist = l - rad;
+        nx = qx / l * sx;
+        ny = qy / l * sy;
+      } else if (qx > qy) {
+        dist = qx - rad;
+        nx = sx;
+        ny = 0.f;
+      } else {
+        dist = qy - rad;
+        nx = 0.f;
+        ny = sy;
+      }
+      float cov = clampf(0.5f - dist, 0.f, 1.f);
+      if (cov <= 0.f) {
+        continue;
+      }
+      float depth = -dist;
+      KDColor c = row[x];
+      // Refraction: near the edge the backdrop is pulled from further in
+      if (depth < bevel && g.refraction > 0) {
+        float t = 1.f - (depth > 0.f ? depth : 0.f) / bevel;
+        float off = t * t * g.refraction;
+        int sxp = x - static_cast<int>(nx * off);
+        int syp = y - static_cast<int>(ny * off);
+        if (sxp != x || syp != y) {
+          c = backdrop(sxp, syp);
+        }
+      }
+      // Same frost and gloss as the fast span, so that both match exactly
+      uint16_t under = row16[x];
+      uint16_t cc = blend565(tint565, static_cast<uint16_t>(c), tint32);
+      if (gloss32) {
+        cc = blend565(0xFFFF, cc, gloss32);
+      }
+      float rim = clampf(1.8f - depth, 0.f, 1.f);
+      if (depth < bevel) {
+        rim += (1.f - depth / bevel) * 0.25f;
+      }
+      if (rim > 0.f) {
+        float lit = nx * k_lx + ny * k_ly;
+        float s = lit > 0 ? lit : -lit * 0.55f;
+        int h = static_cast<int>(rim * s * g.highlight);
+        if (h > 256) {
+          h = 256;
+        }
+        cc = blend565(0xFFFF, cc, static_cast<uint32_t>(h) >> 3);
+      }
+      int a = static_cast<int>(cov * g.alpha);
+      row16[x] = a >= 248 ? cc : blend565(cc, under, static_cast<uint32_t>(a + 4) >> 3);
+      continue;
+    }
+  }
+}
+
+/* --------------------------------------------------------- vector digits */
+
+namespace {
+
+struct Pen {
+  Band* b;
+  float ox, oy, w, h, sw;
+  KDColor c;
+  int alpha;
+  float px, py;
+  bool has;
+  void move(float x, float y) {
+    px = ox + x * w;
+    py = oy + y * h;
+    has = true;
+  }
+  void to(float x, float y) {
+    float nx = ox + x * w, ny = oy + y * h;
+    if (has) {
+      line(*b, px, py, nx, ny, sw, c, alpha);
+    }
+    px = nx;
+    py = ny;
+    has = true;
+  }
+  void arc(float cx, float cy, float rx, float ry, float a0, float a1,
+           int steps) {
+    for (int i = 0; i <= steps; i++) {
+      float a = (a0 + (a1 - a0) * i / steps) * static_cast<float>(M_PI) / 180.f;
+      float x = cx + rx * cosf(a), y = cy + ry * sinf(a);
+      if (i == 0) {
+        move(x, y);
+      } else {
+        to(x, y);
+      }
+    }
+  }
+  void dot(float x, float y, float r) {
+    disc(*b, static_cast<int>(ox + x * w), static_cast<int>(oy + y * h),
+         static_cast<int>(r), c, alpha);
+  }
+};
+
+float charWidth(char ch, int h) {
+  switch (ch) {
+    case ':':
+    case ',':
+    case '.':
+      return h * 0.3f;
+    case '-':
+      return h * 0.5f;
+    case ' ':
+      return h * 0.3f;
+    default:
+      return h * 0.62f;
+  }
+}
+
+constexpr float k_digitGap = 0.16f;
+
+}  // namespace
+
+int digitsWidth(const char* s, int h) {
+  float w = 0.f;
+  int n = 0;
+  for (const char* p = s; *p; p++) {
+    if (static_cast<uint8_t>(*p) == 0xC2) {
+      continue;
+    }
+    if (static_cast<uint8_t>(*p) == 0xB0) {
+      w += h * 0.36f;
+    } else {
+      w += charWidth(*p, h);
+    }
+    n++;
+  }
+  return static_cast<int>(w + (n > 1 ? (n - 1) * h * k_digitGap : 0.f));
+}
+
+void digits(Band& b, const char* s, int x, int y, int h, KDColor c, Align align,
+            int alpha) {
+  int total = digitsWidth(s, h);
+  if (align == Align::Center) {
+    x -= total / 2;
+  } else if (align == Align::Right) {
+    x -= total;
+  }
+  if (!Rect{x - h / 4, y - h / 4, total + h / 2, h + h / 2}.intersects(b.clip())) {
+    return;
+  }
+  float sw = h * 0.085f;
+  if (sw < 1.6f) {
+    sw = 1.6f;
+  }
+  float cx = static_cast<float>(x);
+  for (const char* p = s; *p; p++) {
+    uint8_t ch = static_cast<uint8_t>(*p);
+    if (ch == 0xC2) {
+      continue;
+    }
+    float cw = ch == 0xB0 ? h * 0.36f : charWidth(*p, h);
+    // The box of the strokes' centres, inside the glyph
+    Pen pen = {&b, cx + sw / 2, y + sw / 2, cw - sw, h - sw, sw, c, alpha, 0, 0, false};
+    if (Rect{static_cast<int>(cx) - 2, y - 2, static_cast<int>(cw) + 4, h + 4}.intersects(b.clip())) {
+      switch (ch) {
+        case '0':
+          pen.arc(0.5f, 0.5f, 0.5f, 0.5f, 0, 360, 30);
+          break;
+        case '1':
+          pen.move(0.12f, 0.22f);
+          pen.to(0.62f, 0.f);
+          pen.to(0.62f, 1.f);
+          break;
+        case '2':
+          pen.arc(0.5f, 0.27f, 0.48f, 0.27f, 185, 385, 16);
+          pen.to(0.f, 1.f);
+          pen.to(1.f, 1.f);
+          break;
+        case '3':
+          pen.arc(0.48f, 0.25f, 0.44f, 0.25f, 200, 450, 16);
+          pen.arc(0.5f, 0.73f, 0.5f, 0.27f, 270, 520, 16);
+          break;
+        case '4':
+          pen.move(0.74f, 1.f);
+          pen.to(0.74f, 0.f);
+          pen.to(0.f, 0.68f);
+          pen.to(1.f, 0.68f);
+          break;
+        case '5':
+          pen.move(0.92f, 0.f);
+          pen.to(0.16f, 0.f);
+          pen.to(0.08f, 0.47f);
+          pen.arc(0.5f, 0.67f, 0.48f, 0.33f, 218, 510, 20);
+          break;
+        case '6':
+          pen.arc(0.5f, 0.68f, 0.48f, 0.32f, 0, 360, 24);
+          pen.has = false;
+          pen.arc(0.97f, 0.66f, 0.93f, 0.64f, 180, 252, 8);
+          break;
+        case '7':
+          pen.move(0.f, 0.f);
+          pen.to(1.f, 0.f);
+          pen.to(0.34f, 1.f);
+          break;
+        case '8':
+          pen.arc(0.5f, 0.25f, 0.42f, 0.25f, 0, 360, 22);
+          pen.has = false;
+          pen.arc(0.5f, 0.73f, 0.5f, 0.27f, 0, 360, 24);
+          break;
+        case '9':
+          pen.arc(0.5f, 0.32f, 0.48f, 0.32f, 0, 360, 24);
+          pen.has = false;
+          pen.arc(0.03f, 0.34f, 0.93f, 0.64f, 0, 72, 8);
+          break;
+        case ':':
+          pen.dot(0.5f, 0.3f, sw * 0.75f);
+          pen.dot(0.5f, 0.78f, sw * 0.75f);
+          break;
+        case '.':
+          pen.dot(0.5f, 0.95f, sw * 0.75f);
+          break;
+        case ',':
+          pen.move(0.6f, 0.86f);
+          pen.to(0.35f, 1.12f);
+          break;
+        case '-':
+          pen.move(0.05f, 0.58f);
+          pen.to(0.95f, 0.58f);
+          break;
+        case 0xB0:
+          pen.sw = sw * 0.8f;
+          pen.arc(0.5f, 0.14f, h * 0.11f / (cw - sw), h * 0.11f / (h - sw), 0, 360, 16);
+          break;
+        default:
+          break;
+      }
+    }
+    cx += cw + h * k_digitGap;
+  }
+}
+
+}  // namespace IOS
+}  // namespace Home
