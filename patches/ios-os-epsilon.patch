+// The clock icon shows the time, the calendar icon the date
+static void drawLiveIcon(Band& b, Applet a, int x, int y, int size, int alpha) {
+  float k = size / 36.f;
+  if (a == Applet::Clock) {
+    int sec = clockSeconds();
+    float cx = x + size / 2.f, cy = y + size / 2.f;
+    float hm = (sec % 43200) / 43200.f * 2.f * static_cast<float>(M_PI);
+    float mm = (sec % 3600) / 3600.f * 2.f * static_cast<float>(M_PI);
+    line(b, cx, cy, cx + 7.f * k * sinf(hm), cy - 7.f * k * cosf(hm), 2.2f * k,
+         rgb(0x1C1C1E), alpha);
+    line(b, cx, cy, cx + 10.5f * k * sinf(mm), cy - 10.5f * k * cosf(mm),
+         1.6f * k, rgb(0x1C1C1E), alpha);
+    disc(b, static_cast<int>(cx), static_cast<int>(cy), 1, rgb(0xFF9500), alpha);
+  } else if (a == Applet::Calendar && size >= 28) {
+    Date d = today();
+    char day[4];
+    fmt(day, sizeof(day), "%d", d.day);
+    char wd[4] = {weekdayShort(d.weekday)[0], weekdayShort(d.weekday)[1],
+                  weekdayShort(d.weekday)[2], 0};
+    text(b, wd, x + size / 2, y + static_cast<int>(1 * k), rgb(0xFF3B30), Small,
+         Align::Center);
+    digits(b, day, x + size / 2, y + static_cast<int>(15 * k), static_cast<int>(16 * k),
+           rgb(0x1C1C1E), Align::Center, alpha);
+  }
+}
+
+void drawSlotIcon(Band& b, Slot slot, int x, int y, int size, int alpha) {
+  if (!Rect{x, y, size, size}.intersects(b.clip())) {
+    return;
+  }
+  switch (slot.kind) {
+    case Slot::Kind::Builtin: {
+      int i = builtinPosition(slot.index);
+      image(b, i >= 0 ? s_builtinIcon[i] : IOSIcons::IconGame, x, y, size, alpha);
+      break;
+    }
+    case Slot::Kind::External:
+      if (s_fakeClock) {
+        image(b, IOSIcons::IconGame, x, y, size, alpha);
+      } else {
+        gameIcon(b,
+                 AppsContainer::sharedAppsContainer()->externalAppAtIndex(
+                     slot.index),
+                 x, y, size);
+      }
+      break;
+    case Slot::Kind::Applet: {
+      Applet a = static_cast<Applet>(slot.index);
+      image(b, Apps::icon(a), x, y, size, alpha);
+      drawLiveIcon(b, a, x, y, size, alpha);
+      break;
+    }
+    default:
+      break;
+  }
+}
