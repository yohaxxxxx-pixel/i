+}
+
+static void firstStart() {
+  s.initialized = true;
+  s.screen = Screen::Lock;
+  s.wallpaper = 0;
+  s.dark = false;
+  s.wifi = s.cellular = true;
+  s.volume = 10;
+  s.clockOffsetMinutes = 9 * 60 + 41;
+  s.baseDays = daysFromDate(2026, 11, 22);
+  s.page = 0;
+  s.focus = Focus::Grid;
+  s.column = 4;
+  s.row = 0;
+  s.ccSelected = CCWifi;
+  s.ccPressed = -1;
+  s.islandW = 54.f;
+  s.islandH = 14.f;
+  s.timer.seconds = 5 * 60;
+  s.lastBattery = -1;
+  // Two notes to start with
+  strlcpy(s.notes.text[0],
+          "Bienvenue sur iOS-OS !\nVar : centre de controle.\nOK : ouvrir.",
+          sizeof(s.notes.text[0]));
+  strlcpy(s.notes.text[1], "Reviser les derivees\net les suites pour lundi",
+          sizeof(s.notes.text[1]));
+  s.notes.count = 2;
+  Date d = dateFromDays(s.baseDays);
+  s.calendar = {static_cast<int16_t>(d.year), static_cast<int8_t>(d.month),
+                static_cast<int8_t>(d.day), 0.f};
+}
+
+void enter() {
+  s_loading = false;
+  listApps();
+  if (!s.initialized) {
+    firstStart();
+  }
+  buildLayout();
+  if (s.page >= numberOfPages()) {
+    s.page = 0;
+    selectFirstOfPage();
+  }
+  if (s.focus == Focus::Grid && selectedSlot().isEmpty()) {
+    selectFirstOfPage();
+  }
+  s.scroll = s.page;
+  prepareWallpaper(s.wallpaper, s.dark);
+  /* Coming back here while an iOS-OS app or the control center was open
+   * means the Home key was pressed (the kernel jumps to the home app): like
+   * the home gesture, it goes back to the springboard. */
+  if (s.screen == Screen::App) {
+    s.screen = Screen::Home;
+  }
+  s.ccOpen = false;
+  s.unlockStart = 0;
+  s.alphaLockedByUs = false;
+  if (s.screen == Screen::Home) {
+    s.introStart = now() == 0 ? 1 : now();
+  }
+  s_launch = k_noItem;
+  invalidateAll();
+#if !PLATFORM_DEVICE
+  if (getenv("IOS_SHOTS") && !s_fakeClock) {
+    photoSession();
+  }
+#endif
+}
+
+void leave() {
+  setAlphaLock(false);
+  s.ccOpen = false;
+}
+
+Item takeLaunch() {
+  Item it = s_launch;
+  s_launch = k_noItem;
+  return it;
+}
+
+bool handleEvent(Event e) {
+  if (!e.isKeyboardEvent() || e == Events::OnOff) {
+    return false;
+  }
+  if (e == Events::Shift || e == Events::Alpha) {
+    return false;
+  }
+  if (s.ccOpen && !s.ccClosing) {
+    return ccHandle(e);
+  }
+  if (e == Events::Var && !(s.screen == Screen::App && s.notes.editing &&
+                            s.applet == Applet::Notes)) {
+    openControlCenter();
+    return true;
+  }
+  switch (s.screen) {
+    case Screen::Lock:
+      if (unlocking()) {
+        return true;
+      }
+      if (e == Events::Left) {
+        toggleFlashlight();
+        invalidateAll();
+        return true;
+      }
+      if (e == Events::Right) {
+        s.clockTab = 2;
+        unlock();
+        return true;
+      }
+      if (e == Events::OK || e == Events::EXE || e == Events::Up ||
+          e == Events::Back || e == Events::Home) {
+        unlock();
+      }
+      return true;
+    case Screen::Home:
+      return handleSpringboard(e);
+    case Screen::App:
+      if (s.appletClosing) {
+        return true;
+      }
+      if (e == Events::Home) {
+        closeApplet();
+        return true;
+      }
+      if (Apps::handleEvent(s.applet, e)) {
+        return true;
+      }
+      if (e == Events::Back) {
+        closeApplet();
+        return true;
+      }
+      return e.isKeyboardEvent();
+  }
+  return false;
+}
+
+bool tick() {
+  updateMusic();
+  Apps::tickTimer();
+  // Charger plugged in
+  bool charging = isCharging();
+  if (charging && !s.lastCharging && s.lastBattery >= 0) {
+    islandEvent(3);
+  }
+  s.lastCharging = charging;
+  s.lastBattery = batteryPercent();
+  if (s.timer.ringUntil != 0) {
+    if (now() > s.timer.ringUntil) {
+      s.timer.ringUntil = 0;
+      if (!s_fakeClock) {
+        if (s.flashlight) {
+          Ion::LED::setColor(KDWhite);
+        } else {
+          Ion::LED::updateColorWithPlugAndCharge();
+        }
+      }
+    } else if (!s_fakeClock) {
+      Ion::LED::setColor((now() / 300) % 2 ? KDColor::RGB24(0xFF2020) : KDWhite);
+    }
+  }
+  // The status bar: only when the minute or the battery changes
+  static int lastMinute = -1;
+  static int lastShown = -1;
+  int minute = clockMinutes();
+  int battery = batteryPercent();
+  if (minute != lastMinute || battery != lastShown) {
+    lastMinute = minute;
+    lastShown = battery;
+    invalidate({0, 0, k_screenWidth, 22});
+    if (s.screen == Screen::Lock) {
+      invalidate({0, 30, k_screenWidth, 82});
+    } else if (s.screen == Screen::Home) {
+      // The clock icon
+      invalidateAll();
+    }
+    return true;
+  }
+  return false;
+}
+
+int framePeriod() {
+  int fast = s.lowPower ? 60 : 40;
+  if (s_loading) {
+    return 0;
+  }
+  float w, h;
+  islandTarget(&w, &h);
+  bool islandMoving = fabsf(w - s.islandW) > 0.5f || fabsf(h - s.islandH) > 0.5f;
+  bool slidersMoving =
+      s.ccOpen &&
+      (fabsf(s.brightnessShown - static_cast<float>(brightness()) / Ion::Backlight::MaxBrightness) > 0.004f ||
+       fabsf(s.volumeShown - s.volume / 16.f) > 0.004f);
+  if (introRunning() || s.introStart != 0 || unlocking() || appletZooming() ||
+      ccAnimating() || (s.ccOpen && s.ccClosing) || selectionPopping() ||
+      bannerVisible() || islandMoving || slidersMoving ||
+      fabsf(s.scroll - s.page) > 0.002f || now() - s.ccPressStart < 260) {
+    return fast;
+  }
+  if (s.ccOpen) {
+    return s.music.playing ? 150 : 0;
+  }
+  switch (s.screen) {
+    case Screen::Lock:
+      return 80;
+    case Screen::Home:
+      return s.music.playing || s.timer.running || s.chrono.running ? 150 : 0;
+    case Screen::App:
+      if (Apps::animated(s.applet)) {
+        return 50;
+      }
+      return s.music.playing || s.timer.running || s.chrono.running ? 120 : 0;
+  }
+  return 0;
+}
+
+bool frame() {
+  bool redraw = false;
+  // Dynamic island
+  float w, h;
+  islandTarget(&w, &h);
+  float ow = s.islandW, oh = s.islandH;
+  bool movingW = approach(&s.islandW, w, 0.32f);
+  bool movingH = approach(&s.islandH, h, 0.32f);
+  bool islandMoving = movingW || movingH;
+  if (islandMoving || s.music.playing || s.timer.running || s.chrono.running) {
+    int mw = static_cast<int>((ow > s.islandW ? ow : s.islandW)) + 4;
+    int mh = static_cast<int>((oh > s.islandH ? oh : s.islandH)) + 4;
+    invalidate({160 - mw / 2, 0, mw, mh + k_islandY});
+    redraw = true;
+  }
+  if (s.ccOpen) {
+    if (s.ccClosing && now() - s.ccStart >= k_ccMs) {
+      s.ccOpen = false;
+      s.ccClosing = false;
+      invalidateAll();
+      return true;
+    }
+    if (ccAnimating()) {
+      invalidateAll();
+      return true;
+    }
+    float bv = static_cast<float>(brightness()) / Ion::Backlight::MaxBrightness;
+    if (approach(&s.brightnessShown, bv, 0.4f)) {
+      invalidate(k_cc[CCBrightness].r.inset(-5));
+    }
+    if (approach(&s.volumeShown, s.volume / 16.f, 0.4f)) {
+      invalidate(k_cc[CCVolume].r.inset(-5));
+    }
+    if (s.music.playing) {
+      invalidate(k_cc[CCMusic].r.inset(-5));
+    }
+    if (s.ccPressed >= 0 && now() - s.ccPressStart < 260) {
+      invalidate(k_cc[s.ccPressed].r.inset(-5));
+    }
+    return true;
+  }
+  if (bannerVisible() || (s.banner.start != 0 && now() - s.banner.start < k_bannerMs + 100)) {
+    invalidate({0, 0, k_screenWidth, 56});
+    redraw = true;
+  }
+  switch (s.screen) {
+    case Screen::Lock:
+      if (unlocking()) {
+        if (now() - s.unlockStart >= k_unlockMs) {
+          s.unlockStart = 0;
+          s.screen = Screen::Home;
+          if (s.clockTab == 2) {
+            // Right on the lock screen: straight to the timer
+            openApplet(Applet::Clock, {254, 186, 36, 36});
+          }
+        }
+        invalidateAll();
+        return true;
+      }
+      invalidate({60, 202, 200, 18});
+      return true;
+    case Screen::Home: {
+      bool moving = approach(&s.scroll, static_cast<float>(s.page), 0.34f);
+      if (moving || introRunning()) {
+        invalidateAll();
+        return true;
+      }
+      if (s.introStart != 0) {
+        s.introStart = 0;
+        invalidateAll();
+        return true;
+      }
+      if (selectionPopping() || now() - s.selectStart < 320) {
+        invalidate(focusDirty());
+        return true;
+      }
+      return redraw;
+    }
+    case Screen::App:
+      if (appletZooming()) {
+        invalidateAll();
+        return true;
+      }
+      if (s.appletClosing) {
+        s.appletClosing = false;
+        s.screen = Screen::Home;
+        touchSelection();
+        invalidateAll();
+        return true;
+      }
+      return Apps::frame(s.applet) || redraw;
+  }
+  return redraw;
+}
+
+void render(Band& b) {
+  if (s_capturing) {
+    renderScreen(b);
+    return;
+  }
+  float p = ccProgress();
+  if (p < 1.f || s_loading) {
+    renderScreen(b);
+  }
+  if (!s_loading) {
+    drawControlCenter(b);
+    if (!s.ccOpen) {
+      drawBanner(b);
+    }
+  }
+  if (s.nightShift) {
+    warmFilter(b, 200);
+  }
+}
+
+}  // namespace Shell
+
+/* ========================================================= photo session */
+
+#if !PLATFORM_DEVICE
+namespace {
+
+KDColor s_shot[k_screenWidth * k_screenHeight];
+int s_gifFrame = 0;
+
+void shoot(const char* name) {
+  Band band;
+  for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+    band.begin({0, y, k_screenWidth, Band::k_maxHeight});
+    Shell::render(band);
+    memcpy(s_shot + y * k_screenWidth, band.pixels(),
+           sizeof(KDColor) * k_screenWidth * Band::k_maxHeight);
+  }
+  char path[512];
+  snprintf(path, sizeof(path), "%s/%s.raw", getenv("IOS_SHOTS"), name);
+  FILE* f = fopen(path, "wb");
+  if (f) {
+    fwrite(s_shot, 2, k_screenWidth * k_screenHeight, f);
+    fclose(f);
+  }
+}
+
+void wait(int ms, const char* gif = nullptr, int every = 1) {
+  int n = 0;
+  for (int t = 0; t < ms; t += 40) {
+    s_fakeNow += 40;
+    if ((s_fakeNow / 40) % 8 == 0) {
+      Shell::tick();
+    }
+    Shell::frame();
+    if (gif && (n++ % every) == 0) {
+      char name[64];
+      snprintf(name, sizeof(name), "%s_%04d", gif, s_gifFrame++);
+      shoot(name);
+    }
+  }
+}
+
+void key(Event e, int ms = 200, const char* gif = nullptr) {
+  Shell::handleEvent(e);
+  Shell::takeLaunch();
+  s_loading = false;
+  wait(ms, gif);
+}
+
+double benchRender(int n) {
+  Band band;
+  clock_t start = clock();
+  for (int k = 0; k < n; k++) {
+    for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+      band.begin({0, y, k_screenWidth, Band::k_maxHeight});
+      Shell::render(band);
+    }
+  }
+  return (clock() - start) * 1000.0 / CLOCKS_PER_SEC / n;
+}
+
+template <typename F>
+double benchPart(int n, F f) {
+  Band band;
+  clock_t start = clock();
+  for (int k = 0; k < n; k++) {
+    for (int y = 0; y < k_screenHeight; y += Band::k_maxHeight) {
+      band.begin({0, y, k_screenWidth, Band::k_maxHeight});
+      f(band);
+    }
+  }
+  return (clock() - start) * 1000.0 / CLOCKS_PER_SEC / n;
+}
+
+void bench() {
+  constexpr int n = 40;
+  printf("BENCH lock %.3f ms\n", benchRender(n));
+  s.screen = Screen::Home;
+  printf("BENCH home %.3f ms\n", benchRender(n));
+  printf("BENCH  wallpaper %.3f ms\n", benchPart(n, [](Band& b) { wallpaper(b); }));
+  printf("BENCH  dock %.3f ms\n", benchPart(n, [](Band& b) { drawDock(b); }));
+  printf("BENCH  page0 %.3f ms\n", benchPart(n, [](Band& b) { drawPage(b, 0, 0); }));
+  printf("BENCH  labels %.3f ms\n", benchPart(n, [](Band& b) {
+    for (int i = 0; i < 15; i++) {
+      text(b, "Equations", 32 + (i % 5) * 64, 63 + (i / 5) * 54, KDWhite, KDFont::Size::Small, Align::Center);
+    }
+  }));
+  printf("BENCH  icons %.3f ms\n", benchPart(n, [](Band& b) {
+    for (int i = 0; i < 15; i++) {
+      drawSlotIcon(b, s.slots[3], 14 + (i % 5) * 64, 25 + (i / 5) * 54, 36);
+    }
+  }));
+  printf("BENCH  widgets %.3f ms\n", benchPart(n, [](Band& b) {
+    drawWeatherWidget(b, k_widgetWeather, false, 256);
+    drawCalendarWidget(b, k_widgetCalendar, false, 256);
+  }));
+  printf("BENCH  status %.3f ms\n", benchPart(n, [](Band& b) { drawStatusBar(b, false); }));
+  openControlCenter();
+  s_fakeNow += 2000;
+  printf("BENCH cc %.3f ms\n", benchRender(n));
+  printf("BENCH  ccbg %.3f ms\n", benchPart(n, [](Band& b) { captureBackground(b, 110); }));
+  s.ccOpen = false;
+  openApplet(Applet::Weather, {0, 0, 36, 36});
+  s_fakeNow += 2000;
+  printf("BENCH weather %.3f ms\n", benchRender(n));
+  openApplet(Applet::Settings, {0, 0, 36, 36});
+  s_fakeNow += 2000;
+  printf("BENCH settings %.3f ms\n", benchRender(n));
+  exit(0);
+}
+
+void photoSession() {
+  s_fakeClock = true;
+  if (getenv("IOS_BENCH")) {
+    s_fakeNow = 1000;
+    s_numberOfBuiltin = 0;
+    for (const BuiltinArt& a : k_builtinArt) {
+      s_builtin[s_numberOfBuiltin] = static_cast<int8_t>(s_numberOfBuiltin + 1);
+      s_builtinIcon[s_numberOfBuiltin] = a.icon;
+      s_builtinLabel[s_numberOfBuiltin] = a.label;
+      s_builtinName[s_numberOfBuiltin] = a.name;
+      s_numberOfBuiltin++;
+    }
+    buildLayout();
+    bench();
+  }
+  s_fakeNow = 1000;
+  // Fake calculator apps for the pictures (the simulator has them, but the
+  // labels are what the calculator shows)
+  s_numberOfBuiltin = 0;
+  for (const BuiltinArt& a : k_builtinArt) {
+    s_builtin[s_numberOfBuiltin] = static_cast<int8_t>(s_numberOfBuiltin + 1);
+    s_builtinIcon[s_numberOfBuiltin] = a.icon;
+    s_builtinLabel[s_numberOfBuiltin] = a.label;
+    s_builtinName[s_numberOfBuiltin] = a.name;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = 3;
+  buildLayout();
+  s.screen = Screen::Lock;
+  wait(600);
+  shoot("verrouillage");
+  key(Events::OK, 0);
+  wait(700, "gifunlock");
+  wait(200);
+  shoot("accueil");
+  key(Events::Right, 300, "gifhome");
+  key(Events::Down, 300, "gifhome");
+  key(Events::Right, 300, "gifhome");
+  key(Events::Right, 300, "gifhome");
+  key(Events::Right, 400, "gifhome");
+  shoot("page2");
+  key(Events::Left, 400, "gifhome");
+  key(Events::Up, 200, "gifhome");
+  key(Events::Left, 200, "gifhome");
+  key(Events::Left, 200, "gifhome");
+  key(Events::Left, 200, "gifhome");
+  key(Events::Left, 300, "gifhome");
+  shoot("widget");
+  // Control center
+  key(Events::Up, 0);
+  wait(560, "gifcc");
+  shoot("centre_controle");
+  key(Events::OK, 200, "gifcc");
+  key(Events::Right, 200, "gifcc");
+  key(Events::Right, 200, "gifcc");
+  key(Events::Up, 200, "gifcc");
+  key(Events::Up, 200, "gifcc");
+  key(Events::Down, 200, "gifcc");
+  key(Events::Right, 300, "gifcc");
+  key(Events::Up, 300, "gifcc");
+  key(Events::Up, 300, "gifcc");
+  key(Events::Left, 200, "gifcc");
+  key(Events::Left, 200, "gifcc");
+  key(Events::OK, 300, "gifcc");
+  key(Events::Down, 200, "gifcc");
+  key(Events::Right, 200, "gifcc");
+  key(Events::Right, 200, "gifcc");
+  key(Events::Right, 200, "gifcc");
+  key(Events::OK, 600, "gifcc");
+  shoot("centre_controle_actif");
+  key(Events::Back, 500, "gifcc");
+  shoot("accueil_musique");
+  // Apps
+  struct Shot {
+    Applet applet;
+    const char* name;
+    int ms;
+  };
+  const Shot shots[] = {
+      {Applet::Settings, "reglages", 300}, {Applet::Clock, "horloge", 300},
+      {Applet::Weather, "meteo", 300},     {Applet::Calendar, "calendrier", 300},
+      {Applet::Notes, "notes", 300},       {Applet::Games, "jeux", 300},
+  };
+  for (const Shot& shot : shots) {
+    s.clockTab = 0;
+    openApplet(shot.applet, {100, 100, 36, 36});
+    wait(shot.ms + 200, shot.applet == Applet::Settings ? "gifapp" : nullptr);
+    shoot(shot.name);
+    closeApplet();
+    wait(400, shot.applet == Applet::Settings ? "gifapp" : nullptr);
+  }
+  // Settings: display page
+  openApplet(Applet::Settings, {100, 100, 36, 36});
+  wait(400);
+  for (int i = 0; i < 5; i++) {
+    key(Events::Down, 60);
+  }
+  key(Events::OK, 400);
+  shoot("reglages_affichage");
+  key(Events::Back, 400);
+  key(Events::Down, 60);
+  key(Events::OK, 400);
+  shoot("reglages_fond");
+  key(Events::Right, 100);
+  key(Events::OK, 300);
+  closeApplet();
+  wait(400);
+  // Dark mode, new wallpaper
+  setDark(true);
+  wait(100);
+  shoot("accueil_sombre");
+  s.clockTab = 2;
+  openApplet(Applet::Clock, {100, 100, 36, 36});
+  wait(300);
+  key(Events::OK, 2000);
+  shoot("minuteur");
+  s.clockTab = 1;
+  key(Events::Right, 200);
+  key(Events::Left, 200);
+  key(Events::OK, 1500);
+  key(Events::Backspace, 900);
+  shoot("chrono");
+  closeApplet();
+  wait(400);
+  setDark(false);
+  setWallpaper(0);
+  showBanner("Minuteur", "Termine !", IOSIcons::IconTimer, rgb(0xFF9500));
+  wait(500);
+  shoot("notification");
+  s.nightShift = true;
+  wait(100);
+  shoot("night_shift");
+  exit(0);
+}
