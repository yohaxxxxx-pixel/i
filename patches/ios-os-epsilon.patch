+/* ------------------------------------------------------------- easing */
+
+float clamp01(float t) { return t < 0.f ? 0.f : (t > 1.f ? 1.f : t); }
+
+float easeOut(float t) {
+  t = clamp01(t);
+  float u = 1.f - t;
+  return 1.f - u * u * u;
+}
+
+// Overshoots a little, like a spring
+float easeBack(float t) {
+  t = clamp01(t);
+  constexpr float c1 = 1.5f, c3 = c1 + 1.f;
+  float u = t - 1.f;
+  return 1.f + c3 * u * u * u + c1 * u * u;
+}
+
+float elapsed(uint32_t start, int duration) {
+  if (start == 0) {
+    return 1.f;
+  }
+  return clamp01(static_cast<float>(now() - start) / duration);
+}
+
+bool approach(float* value, float target, float k = 0.35f) {
+  float d = target - *value;
+  if (d > 0.004f || d < -0.004f) {
+    *value += d * k;
+    return true;
+  }
+  *value = target;
+  return false;
+}
+
+Rect lerpRect(Rect a, Rect b, float t) {
+  return {a.x + static_cast<int>((b.x - a.x) * t),
+          a.y + static_cast<int>((b.y - a.y) * t),
+          a.w + static_cast<int>((b.w - a.w) * t),
+          a.h + static_cast<int>((b.h - a.h) * t)};
+}
