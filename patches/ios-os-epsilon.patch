+// RGB565 blend in one multiply per pixel, alpha in 0..32
+inline uint16_t fastBlend(uint16_t fg, uint16_t bg, uint32_t a) {
+  uint32_t f = (fg | (static_cast<uint32_t>(fg) << 16)) & 0x07E0F81F;
+  uint32_t k = (bg | (static_cast<uint32_t>(bg) << 16)) & 0x07E0F81F;
+  uint32_t r = ((f * a + k * (32 - a)) >> 5) & 0x07E0F81F;
+  return static_cast<uint16_t>(r | (r >> 16));
+}
+
+inline void blendPixel(KDColor* p, KDColor c, int alpha) {
+  if (alpha >= 248) {
+    *p = c;
+  } else if (alpha >= 4) {
+    *p = KDColor::RGB16(fastBlend(static_cast<uint16_t>(c),
+                                  static_cast<uint16_t>(*p),
+                                  static_cast<uint32_t>(alpha + 4) >> 3));
+  }
+}
