+int numberOfPages() {
+  int rest = s.numberOfSlots - k_firstPageSlots;
+  return 1 + (rest > 0 ? (rest + k_pageSlots - 1) / k_pageSlots : 0);
+}
+
+/* What is in a cell of a page: -1 nothing, -2 weather widget, -3 calendar
+ * widget, otherwise the index in s.slots */
+constexpr int k_cellEmpty = -1;
+constexpr int k_cellWeather = -2;
+constexpr int k_cellCalendar = -3;
+
+int cellContent(int page, int col, int row) {
+  if (col < 0 || col >= k_columns || row < 0 || row >= k_rows) {
+    return k_cellEmpty;
+  }
+  int index;
+  if (page == 0) {
+    if (row < 2 && col < 2) {
+      return k_cellWeather;
+    }
+    if (row < 2 && col < 4) {
+      return k_cellCalendar;
+    }
+    index = row < 2 ? row : 2 + col;  // column 4 of rows 0-1, then row 2
+  } else {
+    index = k_firstPageSlots + (page - 1) * k_pageSlots + row * k_columns + col;
+  }
+  return index < s.numberOfSlots ? index : k_cellEmpty;
+}
+
+// Top-left corner of the icon of a cell, on page 0 of the scroll
+void cellIconPos(int page, int col, int row, int* x, int* y) {
+  *x = page * k_screenWidth + col * k_cellW + (k_cellW - k_icon) / 2;
+  *y = k_gridY + row * k_cellH + 3;
+}
+
+int scrollOffset() {
+  return static_cast<int>(s.scroll * k_screenWidth + (s.scroll >= 0 ? 0.5f : -0.5f));
+}
