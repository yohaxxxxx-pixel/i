+
+void valueText(uint8_t id, char* buffer, int size) {
+  buffer[0] = 0;
+  Date d = today();
+  int minutes = clockMinutes();
+  switch (id) {
+    case IdHours:
+      fmt(buffer, size, "%02d", minutes / 60);
+      break;
+    case IdMinutes:
+      fmt(buffer, size, "%02d", minutes % 60);
+      break;
+    case IdDay:
+      fmt(buffer, size, "%s %d", weekdayName(d.weekday), d.day);
+      break;
+    case IdMonth:
+      fmt(buffer, size, "%s", monthName(d.month));
+      break;
+    case IdYear:
+      fmt(buffer, size, "%d", d.year);
+      break;
+    case IdName:
+      fmt(buffer, size, "NumWorks");
+      break;
+    case IdVersion:
+      fmt(buffer, size, "iOS-OS 1.0");
+      break;
+    case IdEpsilon:
+      fmt(buffer, size, "26.4.0");
+      break;
+    case IdApps:
+      fmt(buffer, size, "%d", s.numberOfSlots + k_dockSize - numberOfGames());
+      break;
+    case IdGames:
+      fmt(buffer, size, "%d", numberOfGames());
+      break;
+    case IdBatteryLevel:
+      fmt(buffer, size, "%d %%", batteryPercent());
+      break;
+    case IdCharging:
+      fmt(buffer, size, "%s", isCharging() ? "En charge" : "Sur batterie");
+      break;
+    case IdVoltage: {
+      int mv = static_cast<int>(Ion::Battery::voltage() * 1000.f);
+      fmt(buffer, size, "%d,%02d V", mv / 1000, (mv % 1000) / 10);
+      break;
+    }
+    case IdUptime: {
+      uint32_t sec = static_cast<uint32_t>(Ion::Timing::millis() / 1000);
+      fmt(buffer, size, "%d h %02d min", static_cast<int>(sec / 3600),
+          static_cast<int>((sec / 60) % 60));
+      break;
+    }
+    case IdWifi:
+      fmt(buffer, size, "%s", s.wifi ? "iOS-OS" : "Non");
+      break;
+    default:
+      break;
+  }
+}
+
+/* Changes the date while keeping the time: baseDays is the day shown when
+ * the clock reads 00:00 of its first day */
+void setDate(int year, int month, int day) {
+  if (month < 1) {
+    month = 12;
+    year--;
+  } else if (month > 12) {
+    month = 1;
+    year++;
+  }
+  int dim = daysInMonth(year, month);
+  day = day < 1 ? dim : (day > dim ? 1 : day);
+  Date t = today();
+  int32_t current = daysFromDate(t.year, t.month, t.day);
+  s.baseDays += daysFromDate(year, month, day) - current;
+}
+
+void adjust(uint8_t id, int dir) {
+  Date d = today();
+  switch (id) {
+    case IdHours:
+      s.clockOffsetMinutes += dir * 60;
+      // Keep the same day
+      if (clockMinutes() / 60 == (dir > 0 ? 0 : 23)) {
+        s.baseDays -= dir;
+      }
+      break;
+    case IdMinutes:
+      s.clockOffsetMinutes += dir;
+      if (clockMinutes() == (dir > 0 ? 0 : 1439)) {
+        s.baseDays -= dir;
+      }
+      break;
+    case IdDay:
+      setDate(d.year, d.month, d.day + dir);
+      break;
+    case IdMonth:
+      setDate(d.year, d.month + dir, d.day > daysInMonth(d.year, d.month + dir < 1 ? 12 : (d.month + dir > 12 ? 1 : d.month + dir)) ? 1 : d.day);
+      break;
+    case IdYear:
+      setDate(d.year + dir, d.month, d.day > daysInMonth(d.year + dir, d.month) ? daysInMonth(d.year + dir, d.month) : d.day);
+      break;
+    case IdBrightness: {
+      constexpr int k_step = Ion::Backlight::MaxBrightness / 12;
+      int level = brightness() + dir * k_step;
+      setBrightness(level < k_step ? k_step : level);
+      break;
+    }
+    default:
+      break;
+  }
+}
+
+void activate(uint8_t id) {
+  switch (id) {
+    case IdAirplane:
+      toggleAirplane();
+      break;
+    case IdWifi:
+      s.wifi = !s.wifi;
+      s.airplane = s.airplane && !s.wifi;
+      break;
+    case IdBluetooth:
+      s.bluetooth = !s.bluetooth;
+      s.airplane = s.airplane && !s.bluetooth;
+      break;
+    case IdCellular:
+      s.cellular = !s.cellular;
+      s.airplane = s.airplane && !s.cellular;
+      break;
+    case IdFocus:
+      s.focusMode = !s.focusMode;
+      break;
+    case IdNightShift:
+      s.nightShift = !s.nightShift;
+      break;
+    case IdLowPower:
+      toggleLowPower();
+      break;
+    case IdLight:
+      setDark(false);
+      break;
+    case IdDark:
+      setDark(true);
+      break;
+    case IdCalcSettings: {
+      Slot slot = builtinNamed(I18n::Message::SettingsApp);
+      launchSlot(slot);
+      break;
+    }
+    default:
+      break;
+  }
+}
+
+int targetScroll(int page, int selected) {
+  int n;
+  const Row* rows = pageRows(page, &n);
+  if (rows == nullptr || n == 0) {
+    return 0;
+  }
+  int extra = page == PageRoot ? 0 : 16;
+  if (page == PageBattery) {
+    extra += 62;
+  }
+  int y = rowY(rows, selected) + extra;
+  int bottom = rowY(rows, n - 1) + k_rowH + 10 + extra;
+  int scroll = 0;
+  if (y + k_rowH > 232) {
+    scroll = y + k_rowH - 232 + 20;
+  }
+  int maxScroll = bottom - 240;
+  if (maxScroll < 0) {
+    maxScroll = 0;
+  }
+  return scroll > maxScroll ? maxScroll : scroll;
+}
+
+void drawWallpaperPage(Band& b, int ox) {
+  const Theme& t = theme();
+  constexpr const char* k_names[] = {"Aurore", "Ocean", "Crepuscule", "Graphite"};
+  for (int i = 0; i < k_numberOfWallpapers; i++) {
+    Rect r = {ox + 16 + i * 74, 60, 64, 112};
+    if (!r.inset(-4).intersects(b.clip())) {
+      continue;
+    }
+    bool sel = s.settings.selected == i;
+    if (sel) {
+      roundFrame(b, r.inset(-3), 14, t.accent);
+      roundFrame(b, r.inset(-2), 13, t.accent);
+    }
+    // The thumbnail, computed on the fly (only where the band is)
+    Rect z = r.intersection(b.clip());
+    for (int y = z.y; y < z.bottom(); y++) {
+      KDColor* row = b.row(y);
+      float v = (y - r.y) / static_cast<float>(r.h);
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = wallpaperColor(i, (x - r.x) / static_cast<float>(r.w), v);
+      }
+    }
+    roundFrame(b, r, 11, t.background);
+    roundFrame(b, r.inset(1), 10, t.background, 120);
+    // A tiny clock on it, like the lock screen
+    text(b, "9:41", r.x + r.w / 2, r.y + 18, rgb(0xFFFFFF), Small, Align::Center);
+    text(b, k_names[i], r.x + r.w / 2, r.bottom() + 8, sel ? t.accent : t.text,
+         Small, Align::Center);
+    if (s.wallpaper == i) {
+      disc(b, r.x + r.w / 2, r.bottom() + 34, 8, t.accent);
+      tinted(b, IOSIcons::IconCheck, r.x + r.w / 2 - 5, r.bottom() + 29,
+             rgb(0xFFFFFF));
+    }
+  }
+  text(b, "Gauche / droite, puis OK", ox + 160, 222, t.secondary, Small,
+       Align::Center);
+}
+
+void drawBatteryHero(Band& b, int ox, int y) {
+  const Theme& t = theme();
+  Rect card = {ox + 12, y, 296, 50};
+  roundFill(b, card, 12, t.card);
+  int pct = batteryPercent();
+  Rect bat = {card.x + 14, card.y + 13, 60, 24};
+  roundFrame(b, bat, 6, t.secondary);
+  fill(b, {bat.right() + 1, bat.y + 8, 3, 8}, t.secondary);
+  KDColor c = isCharging() ? t.green : (s.lowPower ? t.yellow : (pct < 20 ? t.red : t.green));
+  roundFill(b, {bat.x + 3, bat.y + 3, (54 * pct + 50) / 100, 18}, 4, c);
+  char buffer[16];
+  fmt(buffer, sizeof(buffer), "%d %%", pct);
+  scaledText(b, buffer, card.x + 92, card.y + 12, t.text, 90);
+  text(b, s.lowPower ? "Economie activee" : (isCharging() ? "En charge" : "Normal"),
+       card.right() - 12, card.y + 18, t.secondary, Small, Align::Right);
+}
+
+void drawSettingsPage(Band& b, int page, int ox, int selected, int scroll) {
+  const Theme& t = theme();
+  if (page == PageWallpaper) {
+    largeTitle(b, pageTitle(page), ox + 16, k_top + 6);
+    drawWallpaperPage(b, ox);
+    return;
+  }
+  int n;
+  const Row* rows = pageRows(page, &n);
+  int titleY = k_top + 6 - scroll;
+  int extra = 0;
+  if (page != PageRoot) {
+    text(b, "< Reglages", ox + 12, k_top + 2 - scroll, t.accent, Small);
+    titleY += 14;
+    extra = 16;
+  }
+  largeTitle(b, pageTitle(page), ox + 16, titleY);
+  if (page == PageBattery) {
+    drawBatteryHero(b, ox, k_listTop - scroll + extra + 2);
+    extra += 62;
+  }
+  for (int i = 0; i < n; i++) {
+    const Row& row = rows[i];
+    int y = rowY(rows, i) - scroll + extra;
+    if (row.header) {
+      text(b, row.header, ox + 26, y - 15, t.secondary, Small);
+    }
+    if (y > 240 || y + k_rowH < 0) {
+      continue;
+    }
+    // The card around the section, and the highlight of the selected row
+    bool first = row.sectionStart || i == 0;
+    Rect r = {ox + 12, y, 296, k_rowH};
+    int sectionTop = i, sectionEnd = i;
+    while (sectionTop > 0 && !rows[sectionTop].sectionStart) {
+      sectionTop--;
+    }
+    while (sectionEnd + 1 < n && !rows[sectionEnd + 1].sectionStart) {
+      sectionEnd++;
+    }
+    int top = rowY(rows, sectionTop) - scroll + extra;
+    int bottom = rowY(rows, sectionEnd) - scroll + extra + k_rowH;
+    Rect section = {r.x, top, r.w, bottom - top};
+    Rect old = b.clip();
+    if (b.setClip(r.intersection(old))) {
+      roundFill(b, section, 10, i == selected ? t.highlight : t.card);
+    }
+    b.setClip(old);
+    int tx = r.x + 12;
+    if (row.icon != 255) {
+      settingTile(b, r.x + 8, r.y + 4, row.icon, row.color);
+      tx = r.x + 38;
+    }
+    if (!first) {
+      fill(b, {tx, r.y, r.right() - tx, 1}, t.separator);
+    }
+    if (row.type != Slider) {
+      text(b, row.label, tx, r.y + 8, t.text, Small, Align::Left, 180);
+    }
+    char value[32];
+    switch (row.type) {
+      case Toggle:
+        toggleSwitch(b, r.right() - 46, r.y + 5, toggleValue(row.id));
+        break;
+      case Option:
+        if (toggleValue(row.id)) {
+          tinted(b, IOSIcons::IconCheck, r.right() - 24, r.y + 10, t.accent);
+        }
+        break;
+      case Nav:
+        chevron(b, r.right() - 16, r.y + 11);
+        if (row.id == IdWallpaper) {
+          constexpr const char* k_names[] = {"Aurore", "Ocean", "Crepuscule", "Graphite"};
+          text(b, k_names[s.wallpaper], r.right() - 22, r.y + 8, t.secondary,
+               Small, Align::Right);
+        } else if (row.id == IdBattery) {
+          fmt(value, sizeof(value), "%d %%", batteryPercent());
+          text(b, value, r.right() - 22, r.y + 8, t.secondary, Small, Align::Right);
+        }
+        break;
+      case Value:
+        valueText(row.id, value, sizeof(value));
+        if (i == selected && (page == PageDate)) {
+          text(b, "<", r.right() - 16 - textWidth(value) - 14, r.y + 8, t.accent, Small);
+          text(b, ">", r.right() - 12, r.y + 8, t.accent, Small, Align::Right);
+          text(b, value, r.right() - 24, r.y + 8, t.accent, Small, Align::Right);
+        } else {
+          text(b, value, r.right() - 12, r.y + 8, t.secondary, Small, Align::Right);
+        }
+        break;
+      case Slider: {
+        Rect track = {r.x + 48, r.y + 13, 214, 4};
+        float v = brightness() / static_cast<float>(Ion::Backlight::MaxBrightness);
+        roundFill(b, track, 2, t.separator);
+        roundFill(b, {track.x, track.y, static_cast<int>(track.w * v), 4}, 2, t.accent);
+        int kx = track.x + static_cast<int>(track.w * v);
+        disc(b, kx, track.y + 2, 9, rgb(0xFFFFFF));
+        roundFrame(b, {kx - 9, track.y - 7, 18, 18}, 9, t.separator);
+        tinted(b, IOSIcons::IconSun, r.right() - 26, r.y + 6, t.secondary);
+        break;
+      }
+      case Action:
+        chevron(b, r.right() - 16, r.y + 11);
+        break;
+    }
+  }
+}
+
+bool settingsHandle(Event e) {
+  SettingsUI& ui = s.settings;
+  int n;
+  const Row* rows = pageRows(ui.page, &n);
+  auto push = [&](int page) {
+    ui.previousPage = ui.page;
+    ui.previousSelected = ui.selected;
+    ui.rootSelected = ui.selected;
+    ui.page = static_cast<uint8_t>(page);
+    ui.selected = page == PageWallpaper ? s.wallpaper : 0;
+    ui.navStart = now() == 0 ? 1 : now();
+    ui.navBack = false;
+    ui.scroll = 0.f;
+  };
+  if (e == Events::Back) {
+    if (ui.page == PageRoot) {
+      return false;
+    }
+    ui.previousPage = ui.page;
+    ui.previousSelected = ui.selected;
+    ui.page = PageRoot;
+    ui.selected = ui.rootSelected;
+    ui.navStart = now() == 0 ? 1 : now();
+    ui.navBack = true;
+    ui.scroll = static_cast<float>(targetScroll(PageRoot, ui.selected));
+    invalidateAll();
+    return true;
+  }
+  if (ui.page == PageWallpaper) {
+    if (e == Events::Left && ui.selected > 0) {
+      ui.selected--;
+    } else if (e == Events::Right && ui.selected < k_numberOfWallpapers - 1) {
+      ui.selected++;
+    } else if (e == Events::OK || e == Events::EXE) {
+      setWallpaper(ui.selected);
+    }
+    invalidateAll();
+    return true;
+  }
+  if (e == Events::Up && ui.selected > 0) {
+    ui.selected--;
+  } else if (e == Events::Down && ui.selected < n - 1) {
+    ui.selected++;
+  } else if (e == Events::OK || e == Events::EXE) {
+    const Row& row = rows[ui.selected];
+    if (row.type == Nav) {
+      int page = row.id == IdDisplay     ? PageDisplay
+                 : row.id == IdWallpaper ? PageWallpaper
+                 : row.id == IdBattery   ? PageBattery
+                 : row.id == IdDate      ? PageDate
+                                         : PageAbout;
+      push(page);
+    } else {
+      activate(row.id);
+    }
+  } else if (e == Events::Left || e == Events::Right) {
+    const Row& row = rows[ui.selected];
+    int dir = e == Events::Left ? -1 : 1;
+    if (row.type == Toggle) {
+      if (toggleValue(row.id) != (dir > 0)) {
+        activate(row.id);
+      }
+    } else if (row.type == Value || row.type == Slider) {
+      adjust(row.id, dir);
+    } else if (row.type == Nav && dir > 0) {
+      return settingsHandle(Events::OK);
+    } else if (dir < 0 && ui.page != PageRoot) {
+      return settingsHandle(Events::Back);
+    }
+  } else {
+    return false;
+  }
+  invalidateAll();
+  return true;
+}
+
+void settingsRender(Band& b) {
+  background(b);
+  SettingsUI& ui = s.settings;
+  uint32_t dt = now() - ui.navStart;
+  if (ui.navStart != 0 && dt < 320) {
+    float t = easeOut(dt / 320.f);
+    int w = k_screenWidth;
+    int newX = ui.navBack ? static_cast<int>(-w / 3 * (1.f - t))
+                          : static_cast<int>(w * (1.f - t));
+    int oldX = ui.navBack ? static_cast<int>(w * t) : static_cast<int>(-w / 3 * t);
+    if (ui.navBack) {
+      drawSettingsPage(b, ui.page, newX, ui.selected, static_cast<int>(ui.scroll));
+      dim(b, static_cast<int>((1.f - t) * 40));
+      drawSettingsPage(b, ui.previousPage, oldX, ui.previousSelected, 0);
+    } else {
+      drawSettingsPage(b, ui.previousPage, oldX, ui.previousSelected,
+                       targetScroll(ui.previousPage, ui.previousSelected));
+      dim(b, static_cast<int>(t * 40));
+      // The new page has its own background
+      fill(b, {newX, 0, k_screenWidth, k_screenHeight}, theme().background);
+      drawSettingsPage(b, ui.page, newX, ui.selected, 0);
+    }
+    return;
+  }
+  drawSettingsPage(b, ui.page, 0, ui.selected, static_cast<int>(ui.scroll));
+}
+
+bool settingsFrame() {
+  SettingsUI& ui = s.settings;
+  bool moving = approach(&ui.scroll, static_cast<float>(targetScroll(ui.page, ui.selected)));
+  if (moving || (ui.navStart != 0 && now() - ui.navStart < 360)) {
+    invalidateAll();
+    return true;
+  }
+  return false;
+}
