+// Where the selection is on screen (zoom transitions)
+Rect focusRect() {
+  if (s.screen != Screen::Home && s.screen != Screen::App) {
+    return {142, 102, 36, 36};
+  }
+  if (s.focus == Focus::Dock) {
+    return {dockX(s.dockIndex), k_dockIconY, k_icon, k_icon};
+  }
+  int content = cellContent(s.page, s.column, s.row);
+  if (content == k_cellWeather) {
+    return k_widgetWeather;
+  }
+  if (content == k_cellCalendar) {
+    return k_widgetCalendar;
+  }
+  int x, y;
+  cellIconPos(s.page, s.column, s.row, &x, &y);
+  return {x - s.page * k_screenWidth, y, k_icon, k_icon};
+}
+
+// Everything the selection draws (halo, bigger icon, label)
+Rect focusDirty() {
+  Rect r = focusRect();
+  if (r.w > k_icon) {
+    return r.inset(-4);
+  }
+  return {r.x - 14, r.y - 8, r.w + 28, r.h + 26};
+}
+
+Slot selectedSlot() {
+  if (s.focus == Focus::Dock) {
+    return s.dock[s.dockIndex];
+  }
+  int content = cellContent(s.page, s.column, s.row);
+  if (content == k_cellWeather) {
+    return appletSlot(Applet::Weather);
+  }
+  if (content == k_cellCalendar) {
+    return appletSlot(Applet::Calendar);
+  }
+  return content >= 0 ? s.slots[content] : k_emptySlot;
