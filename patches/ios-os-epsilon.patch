+/* ------------------------------------------------------------------ rect */
+
+Rect Rect::intersection(const Rect& o) const {
+  int x0 = x > o.x ? x : o.x;
+  int y0 = y > o.y ? y : o.y;
+  int x1 = right() < o.right() ? right() : o.right();
+  int y1 = bottom() < o.bottom() ? bottom() : o.bottom();
+  return {x0, y0, x1 - x0, y1 - y0};
+}
+
+/* ------------------------------------------------------------------ band */
+
+void Band::begin(Rect area) {
+  m_area = area;
+  m_clip = area;
+  m_pixels = s_band;
+}
+
+
+bool Band::setClip(Rect r) {
+  m_clip = r.intersection(m_area);
+  return !m_clip.isEmpty();
+}
+
+KDColor* Band::row(int y) const {
+  return m_pixels + (y - m_area.y) * m_area.w - m_area.x;
+}
+
+const KDColor* Band::pixels() const { return m_pixels; }
+
+/* ------------------------------------------------------------ primitives */
+
+void fill(Band& b, Rect r, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    if (alpha >= 256) {
+      for (int x = z.x; x < z.right(); x++) {
+        row[x] = c;
+      }
+    } else {
+      for (int x = z.x; x < z.right(); x++) {
+        blendPixel(row + x, c, alpha);
+      }
+    }
+  }
+}
+
+void frame(Band& b, Rect r, KDColor c, int alpha) {
+  fill(b, {r.x, r.y, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.bottom() - 1, r.w, 1}, c, alpha);
+  fill(b, {r.x, r.y + 1, 1, r.h - 2}, c, alpha);
+  fill(b, {r.right() - 1, r.y + 1, 1, r.h - 2}, c, alpha);
+}
+
+/* Coverage (0..256) of the pixel (px, py) of a rounded rectangle, 0 outside.
+ * Only the corners are curved; they are antialiased on one pixel. No square
+ * root: near the edge, r - d is about (r^2 - d^2) / 2r. */
+static int roundCoverage(const Rect& r, int radius, int px, int py) {
+  int cx, cy;
+  if (px < r.x + radius) {
+    cx = r.x + radius;
+  } else if (px >= r.right() - radius) {
+    cx = r.right() - radius - 1;
+  } else {
+    return 256;
+  }
+  if (py < r.y + radius) {
+    cy = r.y + radius;
+  } else if (py >= r.bottom() - radius) {
+    cy = r.bottom() - radius - 1;
+  } else {
+    return 256;
+  }
+  // In half pixels, from the corner centre
+  int dx = 2 * (px - cx) + (px < cx ? 1 : -1);
+  int dy = 2 * (py - cy) + (py < cy ? 1 : -1);
+  int d2 = dx * dx + dy * dy;  // (2d)^2
+  int r2 = 2 * radius + 1;     // 2 (r + 0.5)
+  int outer = r2 * r2;
+  if (d2 >= outer) {
+    return 0;
+  }
+  int inner = (r2 - 2) * (r2 - 2);  // 2 (r - 0.5)
+  if (d2 <= inner) {
+    return 256;
+  }
+  return (outer - d2) * 256 / (outer - inner);
+}
+
+void roundFill(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  if (radius <= 0) {
+    return fill(b, r, c, alpha);
+  }
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    bool cornerRow = y < r.y + radius || y >= r.bottom() - radius;
+    for (int x = z.x; x < z.right(); x++) {
+      int a = alpha;
+      if (cornerRow) {
+        int cov = roundCoverage(r, radius, x, y);
+        if (cov == 0) {
+          continue;
+        }
+        a = (alpha * cov) >> 8;
+      }
+      blendPixel(row + x, c, a);
+    }
+  }
+}
+
+void roundFrame(Band& b, Rect r, int radius, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  Rect inner = r.inset(1);
+  int innerRadius = radius > 1 ? radius - 1 : 0;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    bool cornerRow = y < r.y + radius || y >= r.bottom() - radius;
+    if (!cornerRow) {
+      // Straight sides: one pixel on each side
+      if (r.x >= z.x) {
+        blendPixel(row + r.x, c, alpha);
+      }
+      if (r.right() - 1 < z.right()) {
+        blendPixel(row + r.right() - 1, c, alpha);
+      }
+      continue;
+    }
+    for (int x = z.x; x < z.right(); x++) {
+      bool edgeRow = y == r.y || y == r.bottom() - 1;
+      bool inCorner = x < r.x + radius || x >= r.right() - radius;
+      if (!edgeRow && !inCorner) {
+        continue;
+      }
+      int outer = roundCoverage(r, radius, x, y);
+      if (outer == 0) {
+        continue;
+      }
+      int in = inner.contains(x, y) ? roundCoverage(inner, innerRadius, x, y)
+                                    : 0;
+      int cov = outer - in;
+      if (cov > 0) {
+        blendPixel(row + x, c, (alpha * cov) >> 8);
+      }
+    }
+  }
+}
+
+void shadow(Band& b, Rect r, int radius, int strength) {
+  roundFill(b, {r.x - 1, r.y + 2, r.w + 2, r.h + 1}, radius + 1, KDBlack,
+            strength / 3);
+}
+
+void image(Band& b, int icon, int x, int y, int size, int alpha) {
+  const IOSIcons::Image& im = IOSIcons::k_images[icon];
+  int w = im.width, h = im.height;
+  int dw = size > 0 ? size : w;
+  int dh = size > 0 ? size * h / w : h;
+  Rect z = Rect{x, y, dw, dh}.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  int step = (w << 16) / dw;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    int sy = (yy - y) * h / dh;
+    const uint16_t* colors = im.colors + sy * w;
+    const uint8_t* alphas = im.alphas + sy * w;
+    int fx = (z.x - x) * step;
+    for (int xx = z.x; xx < z.right(); xx++, fx += step) {
+      int sx = fx >> 16;
+      int a = alphas[sx];
+      if (a) {
+        blendPixel(row + xx, KDColor::RGB16(colors[sx]),
+                   a == 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void tinted(Band& b, int icon, int x, int y, KDColor c, int alpha) {
+  const IOSIcons::Image& im = IOSIcons::k_images[icon];
+  Rect z = Rect{x, y, im.width, im.height}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const uint8_t* alphas = im.alphas + (yy - y) * im.width - x;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int a = alphas[xx];
+      if (a) {
+        blendPixel(row + xx, c, a == 255 ? alpha : (a * alpha) >> 8);
+      }
+    }
+  }
+}
+
+void disc(Band& b, int cx, int cy, int r, KDColor c, int alpha) {
+  roundFill(b, {cx - r, cy - r, 2 * r, 2 * r}, r, c, alpha);
+}
+
+void ellipse(Band& b, Rect r, KDColor c, int alpha) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty() || alpha <= 0) {
+    return;
+  }
+  /* Coverage from the normalised squared distance: near the edge,
+   * 1 - d is about (1 - d^2) / 2, antialiased on about one pixel. */
+  float rx = r.w / 2.f, ry = r.h / 2.f;
+  float cx = r.x + rx, cy = r.y + ry;
+  float scale = (rx < ry ? rx : ry) / 2.f;  // 1 - d^2 -> pixels
+  float irx = 1.f / rx, iry = 1.f / ry;
+  for (int y = z.y; y < z.bottom(); y++) {
+    KDColor* row = b.row(y);
+    float dy = (y + 0.5f - cy) * iry;
+    float dy2 = dy * dy;
+    if (dy2 >= 1.f + 1.f / scale) {
+      continue;
+    }
+    for (int x = z.x; x < z.right(); x++) {
+      float dx = (x + 0.5f - cx) * irx;
+      float edge = (1.f - dx * dx - dy2) * scale + 0.5f;
+      if (edge <= 0.f) {
+        continue;
+      }
+      int cov = edge >= 1.f ? 256 : static_cast<int>(edge * 256);
+      blendPixel(row + x, c, (alpha * cov) >> 8);
+    }
+  }
+}
+
+void vgradient(Band& b, Rect r, KDColor top, KDColor bottom) {
+  Rect z = r.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  for (int y = z.y; y < z.bottom(); y++) {
+    int t = r.h > 1 ? (y - r.y) * 255 / (r.h - 1) : 0;
+    KDColor c = KDColor::Blend(bottom, top, static_cast<uint8_t>(t));
+    KDColor* row = b.row(y);
+    for (int x = z.x; x < z.right(); x++) {
+      row[x] = c;
+    }
+  }
+}
+
+void gameIcon(Band& b, const Ion::ExternalApps::App& app, int x, int y,
+              int size) {
+  Rect z = Rect{x, y, size, size}.intersection(b.clip());
+  if (z.isEmpty()) {
+    return;
+  }
+  const uint8_t* data = app.iconData();
+  uint32_t dataSize = app.iconSize();
+  if (data == nullptr || dataSize == 0) {
+    image(b, IOSIcons::IconGame, x, y, size);
+    return;
+  }
+  OMG::Memory::Decompress(data, reinterpret_cast<uint8_t*>(s_textBuffer),
+                          dataSize,
+                          k_nwaIconWidth * k_nwaIconHeight * sizeof(KDColor));
+  // Rounded corners like the other tiles
+  Rect r = {x, y, size, size};
+  int radius = size / 5;
+  for (int yy = z.y; yy < z.bottom(); yy++) {
+    KDColor* row = b.row(yy);
+    const KDColor* src =
+        s_textBuffer + ((yy - y) * k_nwaIconHeight / size) * k_nwaIconWidth;
+    for (int xx = z.x; xx < z.right(); xx++) {
+      int cov = roundCoverage(r, radius, xx, yy);
+      if (cov) {
+        blendPixel(row + xx, src[(xx - x) * k_nwaIconWidth / size], cov);
+      }
+    }
+  }
+}
