+
+const Row* pageRows(int page, int* n) {
+  switch (page) {
+    case PageDisplay:
+      *n = sizeof(k_display) / sizeof(Row);
+      return k_display;
+    case PageBattery:
+      *n = sizeof(k_battery) / sizeof(Row);
+      return k_battery;
+    case PageDate:
+      *n = sizeof(k_date) / sizeof(Row);
+      return k_date;
+    case PageAbout:
+      *n = sizeof(k_about) / sizeof(Row);
+      return k_about;
+    case PageWallpaper:
+      *n = 0;
+      return nullptr;
+    default:
+      *n = sizeof(k_root) / sizeof(Row);
+      return k_root;
+  }
+}
+
+constexpr int k_rowH = 30;
+constexpr int k_sectionGap = 12;
+constexpr int k_headerGap = 16;
+constexpr int k_listTop = 50;
+
+int rowY(const Row* rows, int i) {
+  int y = k_listTop;
+  for (int j = 0; j <= i; j++) {
+    if (rows[j].sectionStart && j > 0) {
+      y += k_sectionGap;
+    }
+    if (rows[j].header) {
+      y += k_headerGap;
+    }
+    if (j < i) {
+      y += k_rowH;
+    }
+  }
+  return y;
+}
