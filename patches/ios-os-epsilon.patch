+/* iOS-OS apps: Settings, Clock (world clock, stopwatch, timer), Weather,
+ * Calendar, Notes and Games. They run inside the home app, full screen,
+ * opened with a zoom from their icon (see shell.cpp). */
+
+#include <apps/apps_container.h>
+#include <ion/backlight.h>
+#include <ion/battery.h>
+#include <ion/timing.h>
+#include <math.h>
+#include <string.h>
+
+#include "state.h"
+
+namespace Home {
+namespace IOS {
+
+namespace Events = Ion::Events;
+using KDFont::Size::Large;
+using KDFont::Size::Small;
+
+namespace {
+
+float clamp01(float t) { return t < 0.f ? 0.f : (t > 1.f ? 1.f : t); }
+
+float easeOut(float t) {
+  t = clamp01(t);
+  float u = 1.f - t;
+  return 1.f - u * u * u;
+}
+
+bool approach(float* value, float target, float k = 0.34f) {
+  float d = target - *value;
+  if (d > 0.003f || d < -0.003f) {
+    *value += d * k;
+    return true;
+  }
+  *value = target;
+  return false;
+}
+
+constexpr int k_top = 20;  // below the status bar
+
+void background(Band& b) { fill(b, k_screen, theme().background); }
+
+void largeTitle(Band& b, const char* title, int x, int y) {
+  scaledText(b, title, x, y, theme().text, 80);
+}
+
+// An icon tile of the settings: a coloured rounded square with a glyph
+void settingTile(Band& b, int x, int y, uint8_t icon, uint32_t color) {
+  roundFill(b, {x, y, 22, 22}, 6, rgb(color));
+  const IOSIcons::Image& im = IOSIcons::k_images[icon];
+  tinted(b, icon, x + (22 - im.width) / 2, y + (22 - im.height) / 2,
+         rgb(0xFFFFFF));
+}
+
+void toggleSwitch(Band& b, int x, int y, bool on) {
+  const Theme& t = theme();
+  Rect r = {x, y, 36, 20};
+  roundFill(b, r, 10, on ? t.green : (t.dark ? rgb(0x39393D) : rgb(0xD1D1D6)));
+  int kx = on ? x + 18 : x + 2;
+  disc(b, kx + 8, y + 10, 8, rgb(0xFFFFFF));
+}
+
+void chevron(Band& b, int x, int y) {
+  tinted(b, IOSIcons::IconChevron, x, y, theme().secondary);
+}
