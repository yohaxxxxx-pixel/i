+    return;
+  }
+  AppsContainer* container = AppsContainer::sharedAppsContainer();
+  int builtin = container->numberOfBuiltinApps();
+  s_numberOfBuiltin = 0;
+  for (int i = 1; i < builtin && s_numberOfBuiltin < k_maxBuiltin; i++) {
+    I18n::Message name = builtinDescriptor(i)->name();
+    uint8_t icon = IOSIcons::IconGame;
+    const char* label = nullptr;
+    for (const BuiltinArt& a : k_builtinArt) {
+      if (a.name == name) {
+        icon = a.icon;
+        label = a.label;
+      }
+    }
+    s_builtin[s_numberOfBuiltin] = i;
+    s_builtinIcon[s_numberOfBuiltin] = icon;
+    s_builtinLabel[s_numberOfBuiltin] = label ? label : I18n::translate(name);
+    s_builtinName[s_numberOfBuiltin] = name;
+    s_numberOfBuiltin++;
+  }
+  s_numberOfGames = container->numberOfApps() - builtin;
+  if (s_numberOfGames < 0) {
+    s_numberOfGames = 0;
+  }
