+/* ================================================================ Apps */
+
+namespace Apps {
+
+const char* name(Applet a) {
+  constexpr const char* k_names[] = {"Reglages",   "Horloge", "Meteo",
+                                     "Calendrier", "Notes",   "Jeux"};
+  return k_names[static_cast<int>(a)];
+}
+
+uint8_t icon(Applet a) {
+  constexpr uint8_t k_icons[] = {IOSIcons::IconSettings, IOSIcons::IconClock,
+                                 IOSIcons::IconWeather,  IOSIcons::IconCalendar,
+                                 IOSIcons::IconNotes,    IOSIcons::IconGames};
+  return k_icons[static_cast<int>(a)];
+}
+
+void enter(Applet a) {
+  switch (a) {
+    case Applet::Settings:
+      s.settings.page = PageRoot;
+      s.settings.selected = 0;
+      s.settings.scroll = 0.f;
+      s.settings.navStart = 0;
+      break;
+    case Applet::Clock:
+      s.clockTabShown = s.clockTab;
+      break;
+    case Applet::Weather:
+      s.weatherShown = s.weatherCity;
+      break;
+    case Applet::Calendar: {
+      Date d = today();
+      s.calendar = {static_cast<int16_t>(d.year), static_cast<int8_t>(d.month),
+                    static_cast<int8_t>(d.day), 0.f};
+      break;
+    }
+    case Applet::Notes:
+      s.notes.editing = false;
+      if (s.notes.selected >= s.notes.count) {
+        s.notes.selected = -1;
+      }
+      break;
+    case Applet::Games:
+      if (s.gamesSelected >= numberOfGames()) {
+        s.gamesSelected = 0;
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+bool handleEvent(Applet a, Event e) {
+  switch (a) {
+    case Applet::Settings:
+      return settingsHandle(e);
+    case Applet::Clock:
+      return clockHandle(e);
+    case Applet::Weather:
+      return weatherHandle(e);
+    case Applet::Calendar:
+      return calendarHandle(e);
+    case Applet::Notes:
+      return notesHandle(e);
+    case Applet::Games:
+      return gamesHandle(e);
+    default:
+      return false;
+  }
+}
+
+void render(Applet a, Band& b) {
+  switch (a) {
+    case Applet::Settings:
+      settingsRender(b);
+      break;
+    case Applet::Clock:
+      clockRender(b);
+      break;
+    case Applet::Weather:
+      weatherRender(b);
+      break;
+    case Applet::Calendar:
+      calendarRender(b);
+      break;
+    case Applet::Notes:
+      notesRender(b);
+      break;
+    case Applet::Games:
+      gamesRender(b);
+      break;
+    default:
+      break;
+  }
+}
+
+bool animated(Applet a) {
+  switch (a) {
+    case Applet::Settings:
+      return fabsf(s.settings.scroll - targetScroll(s.settings.page, s.settings.selected)) > 0.01f ||
+             (s.settings.navStart != 0 && now() - s.settings.navStart < 360);
+    case Applet::Clock:
+      return s.clockTab == 0 || s.chrono.running ||
+             (s.timer.running && !s.timer.paused) ||
+             fabsf(s.clockTabShown - s.clockTab) > 0.01f;
+    case Applet::Weather:
+      return true;
+    case Applet::Calendar:
+      return fabsf(s.calendar.slide) > 0.003f;
+    case Applet::Notes:
+      return s.notes.editing;
+    default:
+      return false;
+  }
+}
+
+bool frame(Applet a) {
+  switch (a) {
+    case Applet::Settings:
+      return settingsFrame();
+    case Applet::Clock:
+      return clockFrame();
+    case Applet::Weather:
+      return weatherFrame();
+    case Applet::Calendar:
+      return calendarFrame();
+    case Applet::Notes:
+      if (s.notes.editing) {
+        invalidate({0, 40, k_screenWidth, 180});
+        return true;
+      }
+      return false;
+    default:
+      return false;
+  }
+}
+
+bool statusDark(Applet a) { return a != Applet::Weather; }
+
+void tickTimer() {
+  if (s.timer.running && !s.timer.paused && now() >= s.timer.end) {
+    s.timer.running = false;
+    s.timer.ringUntil = now() + 4000;
+    showBanner("Minuteur", "Termine !", IOSIcons::IconTimer, rgb(0xFF9500));
+  }
+}
