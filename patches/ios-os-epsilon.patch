+/* The springboard: the dock (Calculs, Fonctions, Python, Settings), then the
+ * iOS-OS apps mixed with the calculator apps, then the games. */
+void buildLayout() {
+  s.numberOfSlots = 0;
+  auto add = [](Slot slot) {
+    if (!slot.isEmpty() && s.numberOfSlots < k_maxSlots) {
+      s.slots[s.numberOfSlots++] = slot;
+    }
+  };
+  s.dock[0] = builtinNamed(I18n::Message::CalculApp);
+  s.dock[1] = builtinNamed(I18n::Message::FunctionApp);
+  s.dock[2] = builtinNamed(I18n::Message::CodeApp);
+  s.dock[3] = appletSlot(Applet::Settings);
+  add(appletSlot(Applet::Clock));
+  add(appletSlot(Applet::Notes));
+  add(appletSlot(Applet::Games));
+  add(builtinNamed(I18n::Message::SolverApp));
+  add(builtinNamed(I18n::Message::StatsApp));
+  add(builtinNamed(I18n::Message::DistributionsApp));
+  add(builtinNamed(I18n::Message::SequenceApp));
+  // The widgets of page 1 open them too
+  add(appletSlot(Applet::Weather));
+  add(appletSlot(Applet::Calendar));
+  add(builtinNamed(I18n::Message::FinanceApp));
+  add(builtinNamed(I18n::Message::RegressionApp));
+  add(builtinNamed(I18n::Message::InferenceApp));
+  add(builtinNamed(I18n::Message::ElementsApp));
+  add(builtinNamed(I18n::Message::SettingsApp));
+  // Calculator apps that have no place yet (other countries...)
+  for (int i = 0; i < s_numberOfBuiltin; i++) {
+    Slot slot = {Slot::Kind::Builtin, s_builtin[i]};
+    bool found = false;
+    for (int j = 0; j < s.numberOfSlots; j++) {
+      found = found || s.slots[j] == slot;
+    }
+    for (int j = 0; j < k_dockSize; j++) {
+      found = found || s.dock[j] == slot;
+    }
+    if (!found) {
+      add(slot);
+    }
+  }
+  for (int i = 0; i < s_numberOfGames; i++) {
+    add({Slot::Kind::External, static_cast<int8_t>(i)});
+  }
+}
