+#pragma once
+
+/* Internal state of iOS-OS, shared by the springboard and control center
+ * (shell.cpp) and the iOS-OS apps (apps.cpp). Everything is static: it
+ * survives leaving the home app for a calculator app or a game. */
+
+#include <apps/i18n.h>
+#include <ion/events.h>
+#include <stdint.h>
+
+#include "gfx.h"
+#include "shell.h"
+
+namespace Home {
+namespace IOS {
+
+using Ion::Events::Event;
+
+/* ------------------------------------------------------------------ apps */
+
+// The apps of iOS-OS itself
+enum class Applet : uint8_t {
+  Settings = 0,
+  Clock,
+  Weather,
+  Calendar,
+  Notes,
+  Games,
+  NumberOfApplets
+};
+constexpr int k_numberOfApplets = static_cast<int>(Applet::NumberOfApplets);
+
+// One place of the springboard or of the dock
+struct Slot {
+  enum class Kind : uint8_t { Empty, Builtin, External, Applet };
+  Kind kind;
+  int8_t index;  // AppsContainer index, external app index or Applet
+  bool isEmpty() const { return kind == Kind::Empty; }
+  bool operator==(const Slot& o) const {
+    return kind == o.kind && index == o.index;
+  }
+};
+constexpr Slot k_emptySlot = {Slot::Kind::Empty, 0};
+
+inline Slot appletSlot(Applet a) {
+  return {Slot::Kind::Applet, static_cast<int8_t>(a)};
+}
+
+/* ---------------------------------------------------------------- colours */
+
+struct Theme {
+  KDColor background, card, text, secondary, separator, accent, highlight;
+  KDColor green, red, orange, yellow;
+  bool dark;
+};
+const Theme& theme();
+
+/* ------------------------------------------------------------------ state */
+
+enum class Screen : uint8_t { Lock, Home, App };
+enum class Focus : uint8_t { Grid, Dock };
+
+constexpr int k_dockSize = 4;
+constexpr int k_maxSlots = 64;
+constexpr int k_columns = 5;
+constexpr int k_rows = 3;
+constexpr int k_firstPageSlots = 7;  // two widgets take 8 cells
+constexpr int k_pageSlots = k_columns * k_rows;
+
+struct Banner {
+  char title[24];
+  char text[44];
+  uint8_t icon;     // IOSIcons::Icon, or 255 for none
+  uint16_t iconTint;  // RGB565 (State must stay trivial: no static constructor)
+  uint32_t start;   // 0: no banner
+};
+
+struct MusicState {
+  bool playing;
+  uint8_t track;
+  uint32_t position;    // ms
+  uint32_t lastUpdate;  // ms
+};
+
+struct ChronoState {
+  bool running;
+  uint32_t start;        // ms, when running
+  uint32_t accumulated;  // ms
+  constexpr static int k_laps = 4;
+  uint32_t laps[k_laps];
+  uint8_t numberOfLaps;
+};
+
+struct TimerState {
+  uint16_t seconds;    // duration that is set
+  bool running;
+  bool paused;
+  uint32_t end;        // ms, when running
+  uint32_t remaining;  // ms, when paused
+  uint32_t ringUntil;  // ms, LED blinks until then
+};
+
+struct NotesState {
+  constexpr static int k_notes = 6;
+  constexpr static int k_length = 180;
+  char text[k_notes][k_length + 1];
+  uint8_t count;
+  int8_t selected;
+  bool editing;
+};
