+bool toggleValue(uint8_t id) {
+  switch (id) {
+    case IdAirplane:
+      return s.airplane;
+    case IdWifi:
+      return s.wifi;
+    case IdBluetooth:
+      return s.bluetooth;
+    case IdCellular:
+      return s.cellular;
+    case IdFocus:
+      return s.focusMode;
+    case IdNightShift:
+      return s.nightShift;
+    case IdLowPower:
+      return s.lowPower;
+    case IdLight:
