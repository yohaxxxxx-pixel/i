+/* A small printf: the calculator's C library has no vsnprintf. Supports
+ * %d (with width, 0 padding and +), %s, %c and %%. */
+void fmt(char* out, int size, const char* f, ...) {
+  va_list args;
+  va_start(args, f);
+  int n = 0;
+  auto put = [&](char c) {
+    if (n < size - 1) {
+      out[n] = c;
+    }
+    n++;
+  };
+  for (; *f; f++) {
+    if (*f != '%') {
+      put(*f);
+      continue;
+    }
+    f++;
+    bool plus = false, zero = false;
+    if (*f == '+') {
+      plus = true;
+      f++;
+    }
+    if (*f == '0') {
+      zero = true;
+      f++;
+    }
+    int width = 0;
+    while (*f >= '0' && *f <= '9') {
+      width = width * 10 + (*f - '0');
+      f++;
+    }
+    switch (*f) {
+      case 'd': {
+        int v = va_arg(args, int);
+        char digits[12];
+        int k = 0;
+        bool negative = v < 0;
+        unsigned int u = negative ? -static_cast<unsigned int>(v) : static_cast<unsigned int>(v);
+        do {
+          digits[k++] = '0' + u % 10;
+          u /= 10;
+        } while (u);
+        int len = k + (negative || plus ? 1 : 0);
+        if (!zero) {
+          for (int i = len; i < width; i++) {
+            put(' ');
+          }
+        }
+        if (negative) {
+          put('-');
+        } else if (plus) {
+          put('+');
+        }
+        if (zero) {
+          for (int i = len; i < width; i++) {
+            put('0');
+          }
+        }
+        while (k) {
+          put(digits[--k]);
+        }
+        break;
+      }
+      case 's': {
+        const char* str = va_arg(args, const char*);
+        for (; str && *str; str++) {
+          put(*str);
+        }
+        break;
+      }
+      case 'c':
+        put(static_cast<char>(va_arg(args, int)));
+        break;
+      case '%':
+        put('%');
+        break;
+      default:
+        if (!*f) {
+          f--;
+        }
+        break;
+    }
+  }
+  out[n < size ? n : size - 1] = 0;
+  va_end(args);
+}
+
+static int64_t totalMinutes() {
+  return static_cast<int64_t>(s.clockOffsetMinutes) + now() / 60000;
+}
+
+int clockMinutes() {
+  int m = static_cast<int>(totalMinutes() % 1440);
+  return m < 0 ? m + 1440 : m;
+}
+
+int clockSeconds() {
+  return clockMinutes() * 60 + static_cast<int>((now() / 1000) % 60);
+}
+
+void clockText(char* buffer, int size, int minutes) {
+  fmt(buffer, size, "%02d:%02d", minutes / 60, minutes % 60);
+}
+
+// Howard Hinnant's algorithms
+int32_t daysFromDate(int y, int m, int d) {
+  y -= m <= 2;
+  int era = (y >= 0 ? y : y - 399) / 400;
+  int yoe = y - era * 400;
+  int doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+  int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + doe - 719468;
+}
+
+Date dateFromDays(int32_t z) {
+  z += 719468;
+  int era = (z >= 0 ? z : z - 146096) / 146097;
+  int doe = z - era * 146097;
+  int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+  int y = yoe + era * 400;
+  int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+  int mp = (5 * doy + 2) / 153;
+  int d = doy - (153 * mp + 2) / 5 + 1;
+  int m = mp + (mp < 10 ? 3 : -9);
+  int32_t days = z - 719468;
+  int wd = static_cast<int>((days % 7 + 7 + 3) % 7);  // 1970-01-01: Thursday
+  return {y + (m <= 2), m, d, wd};
+}
+
+int daysInMonth(int year, int month) {
+  constexpr int k_days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+  if (month == 2) {
+    bool leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+    return leap ? 29 : 28;
+  }
+  return k_days[(month - 1) % 12];
+}
+
+Date today() {
+  int64_t t = totalMinutes();
+  int32_t day = static_cast<int32_t>(t >= 0 ? t / 1440 : (t - 1439) / 1440);
+  return dateFromDays(s.baseDays + day);
+}
+
+const char* weekdayName(int w) {
+  constexpr const char* k_names[] = {"lundi",    "mardi",  "mercredi", "jeudi",
+                                     "vendredi", "samedi", "dimanche"};
+  return k_names[w % 7];
+}
+
+const char* weekdayShort(int w) {
+  constexpr const char* k_names[] = {"LUN.", "MAR.", "MER.", "JEU.",
+                                     "VEN.", "SAM.", "DIM."};
+  return k_names[w % 7];
+}
+
+const char* monthName(int m) {
+  constexpr const char* k_names[] = {
+      "janvier", "fevrier", "mars",      "avril",   "mai",      "juin",
+      "juillet", "aout",    "septembre", "octobre", "novembre", "decembre"};
+  return k_names[(m + 11) % 12];
+}
