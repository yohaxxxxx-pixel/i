+                colors.append(rgb565(r, g, b))
+                alphas.append(a)
+        lines.append(f"constexpr uint16_t k_{name}Colors[{w * h}] = {{")
+        for i in range(0, len(colors), 24):
+            lines.append("  " + ", ".join(str(v) for v in colors[i:i + 24]) + ",")
+        lines.append("};")
+        lines.append(f"constexpr uint8_t k_{name}Alphas[{w * h}] = {{")
+        for i in range(0, len(alphas), 32):
+            lines.append("  " + ", ".join(str(v) for v in alphas[i:i + 32]) + ",")
+        lines.append("};")
+    lines.append(f"constexpr Image k_images[{len(images)}] = {{")
+    for name, img in images:
+        w, h = img.size
+        lines.append(f"  {{{w}, {h}, k_{name}Colors, k_{name}Alphas}},")
+    lines += ["};", "", "}  // namespace IOSIcons", "}  // namespace Home", ""]
+    with open(out, "w") as f:
+        f.write("\n".join(lines))
+    if preview:
+        scale = 4
+        cols = 10
+        sheet = Image.new("RGBA", (cols * 40 * scale, ((len(images) + cols - 1) // cols) * 40 * scale),
+                          (60, 70, 90, 255))
+        for i, (_, img) in enumerate(images):
