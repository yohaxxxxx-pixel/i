+namespace {
+
+void drawBattery(Band& b, int x, int y, KDColor c) {
+  int pct = batteryPercent();
+  roundFrame(b, {x, y, 21, 10}, 3, c, 150);
+  fill(b, {x + 22, y + 3, 2, 4}, c, 150);
+  KDColor level = c;
+  if (isCharging()) {
+    level = theme().green;
+  } else if (s.lowPower) {
+    level = rgb(0xFFCC00);
+  } else if (pct < 20) {
+    level = rgb(0xFF3B30);
+  }
+  int w = (17 * pct + 50) / 100;
+  roundFill(b, {x + 2, y + 2, w < 2 ? 2 : w, 6}, 2, level);
+}
+
+void drawCellular(Band& b, int x, int y, KDColor c) {
+  for (int i = 0; i < 4; i++) {
+    int h = 3 + i * 2;
+    roundFill(b, {x + i * 4, y + 9 - h, 3, h}, 1, c, s.cellular ? 256 : 80);
+  }
+}
+
+constexpr int k_islandY = 3;
+
+void drawIsland(Band& b) {
+  int w = static_cast<int>(s.islandW + 0.5f), h = static_cast<int>(s.islandH + 0.5f);
+  Rect r = {160 - w / 2, k_islandY, w, h};
+  if (!r.inset(-1).intersects(b.clip())) {
+    return;
+  }
+  roundFill(b, r, h / 2, KDBlack);
+  // Content only when the island has (nearly) reached its size
+  if (s.islandEvent != 0 && now() < s.islandEventUntil && w > 130) {
+    const char* label = "";
+    uint8_t icon = IOSIcons::IconFlashlight;
+    KDColor tint = rgb(0xFFFFFF);
+    char buffer[24];
+    switch (s.islandEvent) {
+      case 1:
+        label = s.flashlight ? "Lampe allumee" : "Lampe eteinte";
+        icon = IOSIcons::IconFlashlight;
+        tint = s.flashlight ? rgb(0xFFD60A) : rgb(0x8E8E93);
+        break;
+      case 2:
+        label = s.focusMode ? "Ne pas deranger" : "Concentration off";
+        icon = IOSIcons::IconMoon;
+        tint = rgb(0x7D7AFF);
+        break;
+      case 3:
+        fmt(buffer, sizeof(buffer), "En charge %d%%", batteryPercent());
+        label = buffer;
+        icon = IOSIcons::IconBattery;
+        tint = rgb(0x30D158);
+        break;
+      case 4:
+        label = s.volume == 0 ? "Mode silence" : "Sonnerie";
+        icon = IOSIcons::IconSpeaker;
+        tint = s.volume == 0 ? rgb(0xFF453A) : rgb(0xFFFFFF);
+        break;
+    }
+    tinted(b, icon, r.x + 8, r.y + (h - 18) / 2, tint);
+    text(b, label, r.x + 30, r.y + (h - 14) / 2, rgb(0xFFFFFF), Small,
+         Align::Left, w - 36);
+    return;
+  }
+  if (w > 80) {
+    if (s.timer.running || s.chrono.running) {
+      char buffer[12];
+      uint32_t ms;
+      KDColor c = rgb(0xFF9F0A);
+      if (s.timer.running) {
+        ms = s.timer.paused ? s.timer.remaining
+                            : (s.timer.end > now() ? s.timer.end - now() : 0);
+        ms += 999;
+      } else {
+        ms = s.chrono.accumulated + (now() - s.chrono.start);
+        c = rgb(0x30D158);
+      }
+      fmt(buffer, sizeof(buffer), "%d:%02d", static_cast<int>(ms / 60000),
+          static_cast<int>((ms / 1000) % 60));
+      tinted(b, s.timer.running ? IOSIcons::IconTimer : IOSIcons::IconStopwatch,
+             r.x + 6, r.y + (h - 18) / 2, c);
+      text(b, buffer, r.right() - 8, r.y + (h - 14) / 2, c, Small, Align::Right);
+    } else if (s.music.playing) {
+      image(b, IOSIcons::IconAlbum, r.x + 5, r.y + 2, h - 4);
+      // Waveform
+      uint32_t t = now() / 90;
+      for (int i = 0; i < 5; i++) {
+        int bh = 3 + static_cast<int>((t * (i + 3) * 7 + i * 13) % 9);
+        if (bh > h - 6) {
+          bh = h - 6;
+        }
+        roundFill(b, {r.right() - 30 + i * 4, r.y + (h - bh) / 2, 2, bh}, 1,
+                  rgb(0xFF375F));
+      }
+    }
+  }
+}
+
+void islandTarget(float* w, float* h) {
+  if (s.islandEvent != 0 && now() < s.islandEventUntil) {
+    *w = 150.f;
+    *h = 22.f;
+  } else if (s.timer.running || s.chrono.running || s.music.playing) {
+    *w = 96.f;
+    *h = 16.f;
+  } else {
+    *w = 54.f;
+    *h = 14.f;
+  }
+}
